// random.ume — Ume Standard Library (Random)
package std.random;

/// Pseudo-random number generator using a 64-bit Linear Congruential Generator.
/// Parameters from Knuth / MMIX: a=6364136223846793005, c=1442695040888963407, m=2^63
///
/// Usage:
///   Random rng = new Random();          // seeded from clock
///   Random rng = new Random(42);        // fixed seed
///   int    n   = rng.nextInt();         // [0, 2147483647]
///   int    n   = rng.nextIntMax(100);   // [0, 100)
///   int    n   = rng.nextIntRange(1, 6);// [1, 6)  — like a die roll
///   double d   = rng.nextDouble();      // [0.0, 1.0)
///   bool   b   = rng.nextBool();        // true or false
public class Random {
    private long state;

    // Seeded from the current time (different sequence each run)
    Random() {
        state = cast<long>(System.currentTimeMillis());
        if (state < 0) { state = -state; }
        if (state == 0) { state = 12345; }
        // Warm up the generator so the first value isn't correlated with the seed
        _next(); _next(); _next();
    }

    // Fixed seed — produces the same sequence every run (useful for tests)
    Random(long seed) {
        state = seed;
        if (state < 0) { state = -state; }
        if (state == 0) { state = 12345; }
        _next(); _next(); _next();
    }

    // ── Core LCG step (private) ──────────────────────────────────────
    private func long _next() {
        // Numerical Recipes LCG — overflow-safe for 64-bit signed arithmetic:
        //   1664525 * state < 1664525 * 2^32 ≈ 7.14e15  <<  INT64_MAX ≈ 9.2e18
        state = (1664525 * state + 1013904223) % 4294967296;
        return state;
    }

    // ── Public API ───────────────────────────────────────────────────

    /// Returns a non-negative random int in [0, 2147483647]
    public func int nextInt() {
        return cast<int>(_next() % 2147483647);
    }

    /// Returns a random int in [0, max)
    public func int nextInt(int max) {
        return nextIntMax(max);
    }

    /// Returns a random int in [min, max)
    public func int nextInt(int min, int max) {
        return nextIntRange(min, max);
    }

    /// Returns a random int in [0, max)
    public func int nextIntMax(int max) {
        if (max <= 1) { return 0; }
        return cast<int>(_next() % cast<long>(max));
    }

    /// Returns a random int in [min, max)
    public func int nextIntRange(int min, int max) {
        if (max <= min) { return min; }
        return min + cast<int>(_next() % cast<long>(max - min));
    }

    /// Returns a random double in [0.0, 1.0)
    public func double nextDouble() {
        return cast<double>(_next() % 1000000000) / 1000000000.0;
    }

    /// Returns a random double in [min, max)
    public func double nextDoubleRange(double min, double max) {
        return min + nextDouble() * (max - min);
    }

    /// Returns true or false with equal probability
    public func bool nextBool() {
        return _next() % 2 == 0;
    }

    /// Shuffles an integer array in-place (Fisher-Yates)
    public func void shuffleInts(int[] arr) {
        int n = arr.length();
        for (int i = n - 1; i > 0; i--) {
            int j = nextIntMax(i + 1);
            int tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
        }
    }
}
