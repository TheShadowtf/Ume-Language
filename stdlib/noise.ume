package noise;

import std.math.*;
import std.random.*;

public class Noise {
    private int[] perm;
    private int[] p;

    public Noise(int seed) {
        perm = new int[256];
        p = new int[512];
        init(seed);
    }

    private func void init(int seed) {
        for (int i = 0; i < 256; i++) {
            perm[i] = i;
        }

        // Shuffle using a Linear Congruential Generator (LCG)
        int s = seed;
        for (int i = 255; i > 0; i--) {
            s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
            int j = s % (i + 1);
            int tmp = perm[i];
            perm[i] = perm[j];
            perm[j] = tmp;
        }

        // Duplicate permutation table to avoid wrapping index bounds
        for (int i = 0; i < 512; i++) {
            p[i] = perm[i & 255];
        }
    }

    // ── Helper Math Functions ───────────────────────────────────────────────
    private func double fade(double t) {
        // Quintic curve: 6t^5 - 15t^4 + 10t^3 (smoother derivatives than cubic)
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    private func double lerp(double t, double a, double b) {
        return a + t * (b - a);
    }

    private func int fastFloor(double v) {
        int i = cast<int>(v);
        return (v < cast<double>(i)) ? (i - 1) : i;
    }

    private func double grad2D(int hash, double x, double y) {
        int h = hash & 7;
        double u = (h < 4) ? x : y;
        double v = (h < 4) ? y : x;
        return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
    }

    private func double grad3D(int hash, double x, double y, double z) {
        int h = hash & 15;
        double u = (h < 8) ? x : y;
        double v = (h < 4) ? y : ((h == 12 || h == 14) ? x : z);
        return ((h & 1) == 0 ? u : -u) + ((h & 2) == 0 ? v : -v);
    }

    // ── 1. Classic Perlin Noise (Returns values roughly in [-1.0, 1.0]) ────
    public func double perlin2D(double x, double y) {
        int xi = fastFloor(x);
        int yi = fastFloor(y);

        double xf = x - cast<double>(xi);
        double yf = y - cast<double>(yi);

        int X = xi & 255;
        int Y = yi & 255;

        double u = fade(xf);
        double v = fade(yf);

        int aa = p[p[X] + Y];
        int ab = p[p[X] + Y + 1];
        int ba = p[p[X + 1] + Y];
        int bb = p[p[X + 1] + Y + 1];

        double x1 = lerp(u, grad2D(aa, xf, yf), grad2D(ba, xf - 1.0, yf));
        double x2 = lerp(u, grad2D(ab, xf, yf - 1.0), grad2D(bb, xf - 1.0, yf - 1.0));

        return lerp(v, x1, x2);
    }

    public func double perlin3D(double x, double y, double z) {
        int xi = fastFloor(x);
        int yi = fastFloor(y);
        int zi = fastFloor(z);

        double xf = x - cast<double>(xi);
        double yf = y - cast<double>(yi);
        double zf = z - cast<double>(zi);

        int X = xi & 255;
        int Y = yi & 255;
        int Z = zi & 255;

        double u = fade(xf);
        double v = fade(yf);
        double w = fade(zf);

        int a  = p[X] + Y;
        int aa = p[a] + Z;
        int ab = p[a + 1] + Z;
        int b  = p[X + 1] + Y;
        int ba = p[b] + Z;
        int bb = p[b + 1] + Z;

        double g000 = grad3D(p[aa],     xf,        yf,        zf);
        double g100 = grad3D(p[ba],     xf - 1.0,  yf,        zf);
        double g010 = grad3D(p[ab],     xf,        yf - 1.0,  zf);
        double g110 = grad3D(p[bb],     xf - 1.0,  yf - 1.0,  zf);
        double g001 = grad3D(p[aa + 1], xf,        yf,        zf - 1.0);
        double g101 = grad3D(p[ba + 1], xf - 1.0,  yf,        zf - 1.0);
        double g011 = grad3D(p[ab + 1], xf,        yf - 1.0,  zf - 1.0);
        double g111 = grad3D(p[bb + 1], xf - 1.0,  yf - 1.0,  zf - 1.0);

        double l0 = lerp(u, g000, g100);
        double l1 = lerp(u, g010, g110);
        double l2 = lerp(u, g001, g101);
        double l3 = lerp(u, g011, g111);

        double ly1 = lerp(v, l0, l1);
        double ly2 = lerp(v, l2, l3);

        return lerp(w, ly1, ly2);
    }

    // ── 2. Simplex Noise (Faster 3D iteration, fewer grid line artifacts) ──
    public func double simplex2D(double xin, double yin) {
        double F2 = 0.5 * (Math.sqrt(3.0) - 1.0);
        double s = (xin + yin) * F2;
        int i = fastFloor(xin + s);
        int j = fastFloor(yin + s);

        double G2 = (3.0 - Math.sqrt(3.0)) / 6.0;
        double t = cast<double>(i + j) * G2;
        double X0 = cast<double>(i) - t;
        double Y0 = cast<double>(j) - t;
        double x0 = xin - X0;
        double y0 = yin - Y0;

        int i1 = 0;
        int j1 = 0;
        if (x0 > y0) { i1 = 1; j1 = 0; }
        else         { i1 = 0; j1 = 1; }

        double x1 = x0 - cast<double>(i1) + G2;
        double y1 = y0 - cast<double>(j1) + G2;
        double x2 = x0 - 1.0 + 2.0 * G2;
        double y2 = y0 - 1.0 + 2.0 * G2;

        int ii = i & 255;
        int jj = j & 255;

        double n0 = 0.0;
        double t0 = 0.5 - x0 * x0 - y0 * y0;
        if (t0 > 0.0) {
            t0 *= t0;
            n0 = t0 * t0 * grad2D(p[ii + p[jj]], x0, y0);
        }

        double n1 = 0.0;
        double t1 = 0.5 - x1 * x1 - y1 * y1;
        if (t1 > 0.0) {
            t1 *= t1;
            n1 = t1 * t1 * grad2D(p[ii + i1 + p[jj + j1]], x1, y1);
        }

        double n2 = 0.0;
        double t2 = 0.5 - x2 * x2 - y2 * y2;
        if (t2 > 0.0) {
            t2 *= t2;
            n2 = t2 * t2 * grad2D(p[ii + 1 + p[jj + 1]], x2, y2);
        }

        return 70.0 * (n0 + n1 + n2);
    }

    public func double simplex3D(double xin, double yin, double zin) {
        double F3 = 1.0 / 3.0;
        double s = (xin + yin + zin) * F3;
        int i = fastFloor(xin + s);
        int j = fastFloor(yin + s);
        int k = fastFloor(zin + s);

        double G3 = 1.0 / 6.0;
        double t = cast<double>(i + j + k) * G3;
        double X0 = cast<double>(i) - t;
        double Y0 = cast<double>(j) - t;
        double Z0 = cast<double>(k) - t;
        double x0 = xin - X0;
        double y0 = yin - Y0;
        double z0 = zin - Z0;

        int i1 = 0; int j1 = 0; int k1 = 0;
        int i2 = 0; int j2 = 0; int k2 = 0;

        if (x0 >= y0) {
            if (y0 >= z0)      { i1 = 1; j1 = 0; k1 = 0; i2 = 1; j2 = 1; k2 = 0; }
            else if (x0 >= z0) { i1 = 1; j1 = 0; k1 = 0; i2 = 1; j2 = 0; k2 = 1; }
            else               { i1 = 0; j1 = 0; k1 = 1; i2 = 1; j2 = 0; k2 = 1; }
        } else {
            if (y0 < z0)       { i1 = 0; j1 = 0; k1 = 1; i2 = 0; j2 = 1; k2 = 1; }
            else if (x0 < z0)  { i1 = 0; j1 = 1; k1 = 0; i2 = 0; j2 = 1; k2 = 1; }
            else               { i1 = 0; j1 = 1; k1 = 0; i2 = 1; j2 = 1; k2 = 0; }
        }

        double x1 = x0 - cast<double>(i1) + G3;
        double y1 = y0 - cast<double>(j1) + G3;
        double z1 = z0 - cast<double>(k1) + G3;

        double x2 = x0 - cast<double>(i2) + 2.0 * G3;
        double y2 = y0 - cast<double>(j2) + 2.0 * G3;
        double z2 = z0 - cast<double>(k2) + 2.0 * G3;

        double x3 = x0 - 1.0 + 3.0 * G3;
        double y3 = y0 - 1.0 + 3.0 * G3;
        double z3 = z0 - 1.0 + 3.0 * G3;

        int ii = i & 255;
        int jj = j & 255;
        int kk = k & 255;

        double n0 = 0.0;
        double t0 = 0.6 - x0 * x0 - y0 * y0 - z0 * z0;
        if (t0 > 0.0) {
            t0 *= t0;
            n0 = t0 * t0 * grad3D(p[ii + p[jj + p[kk]]], x0, y0, z0);
        }

        double n1 = 0.0;
        double t1 = 0.6 - x1 * x1 - y1 * y1 - z1 * z1;
        if (t1 > 0.0) {
            t1 *= t1;
            n1 = t1 * t1 * grad3D(p[ii + i1 + p[jj + j1 + p[kk + k1]]], x1, y1, z1);
        }

        double n2 = 0.0;
        double t2 = 0.6 - x2 * x2 - y2 * y2 - z2 * z2;
        if (t2 > 0.0) {
            t2 *= t2;
            n2 = t2 * t2 * grad3D(p[ii + i2 + p[jj + j2 + p[kk + k2]]], x2, y2, z2);
        }

        double n3 = 0.0;
        double t3 = 0.6 - x3 * x3 - y3 * y3 - z3 * z3;
        if (t3 > 0.0) {
            t3 *= t3;
            n3 = t3 * t3 * grad3D(p[ii + 1 + p[jj + 1 + p[kk + 1]]], x3, y3, z3);
        }

        return 32.0 * (n0 + n1 + n2 + n3);
    }

    // ── 3. Worley / Cellular Noise (Great for underground cavern rooms) ────
    private func double hashPoint(int xi, int yi, int zi, int axis) {
        int h = p[(xi + p[(yi + p[zi & 255]) & 255] + axis * 13) & 255];
        return cast<double>(h) / 255.0;
    }

    public func double worley3D(double x, double y, double z) {
        int xi = fastFloor(x);
        int yi = fastFloor(y);
        int zi = fastFloor(z);

        double minDist = 9999.0;

        for (int ox = -1; ox <= 1; ox++) {
            for (int oy = -1; oy <= 1; oy++) {
                for (int oz = -1; oz <= 1; oz++) {
                    int cx = xi + ox;
                    int cy = yi + oy;
                    int cz = zi + oz;

                    double px = cast<double>(cx) + hashPoint(cx, cy, cz, 1);
                    double py = cast<double>(cy) + hashPoint(cx, cy, cz, 2);
                    double pz = cast<double>(cz) + hashPoint(cx, cy, cz, 3);

                    double dx = px - x;
                    double dy = py - y;
                    double dz = pz - z;
                    double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

                    if (dist < minDist) {
                        minDist = dist;
                    }
                }
            }
        }
        return minDist; // Lower value = closer to cell center
    }

    // ── 4. Fractal Brownian Motion (Octaves for detail/realism) ─────────────
    public func double fbm2D(double x, double y, int octaves, double lacunarity, double gain) {
        double sum = 0.0;
        double amp = 1.0;
        double freq = 1.0;
        double maxAmp = 0.0;

        for (int i = 0; i < octaves; i++) {
            sum += perlin2D(x * freq, y * freq) * amp;
            maxAmp += amp;
            freq *= lacunarity;
            amp *= gain;
        }
        return sum / maxAmp;
    }

    public func double fbm3D(double x, double y, double z, int octaves, double lacunarity, double gain) {
        double sum = 0.0;
        double amp = 1.0;
        double freq = 1.0;
        double maxAmp = 0.0;

        for (int i = 0; i < octaves; i++) {
            sum += perlin3D(x * freq, y * freq, z * freq) * amp;
            maxAmp += amp;
            freq *= lacunarity;
            amp *= gain;
        }
        return sum / maxAmp;
    }
}