    public func void rebuildDirtyChunks(int maxPerFrame) {
        int rebuilt = 0;
        for (int i = 0; i < count; i++) {
            if (chunks[i].dirty && chunks[i].generated) {
                buildMesh(i); 
                rebuilt++;
                if (rebuilt >= maxPerFrame) return;
            }
        }
    }
