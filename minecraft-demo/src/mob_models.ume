// ═══════════════════════════════════════════════════════════════════════════
// mob_models.ume — Multipart mob models with walk animation
// ═══════════════════════════════════════════════════════════════════════════
//
// A MobModel is a list of MobPart. Each part has its own Mesh plus an
// offset and an animation role (legs swing, head bobs, body bobs, etc.).
// During rendering each part is drawn with its own model matrix so legs
// can rotate independently from the body.
//
// Part naming convention (so renderers can match animations):
//   "body", "head", "legFL", "legFR", "legBL", "legBR",
//   "legFL2", "legFR2", "legBL2", "legBR2"  (spider has 8 legs)
//   "wool" (sheep), "snout" (pig), "comb" (chicken), "wingL", "wingR"
//
// Coordinate convention:
//   - Each part's mesh is centered on its own local origin (0,0,0) and
//     extends from (-w/2, 0, -d/2) to (+w/2, h, +d/2) — bottom at y=0.
//   - The part's offset places the local origin inside the mob's frame.
//   - The mob's frame is centered on (x, z) at y = mob.y (feet).

import std.math.*;

// ── Animation roles ──────────────────────────────────────────────────────────
public int ANIM_NONE     = 0;  // static
public int ANIM_LEG      = 1;  // rotate around X axis based on walk phase
public int ANIM_LEG_INV  = 2;  // same as LEG but opposite phase (other side)
public int ANIM_BODY_BOB = 3;  // translate Y by small sin
public int ANIM_HEAD     = 4;  // slight nod based on walk phase
public int ANIM_WING     = 5;  // chicken wing flap
public int ANIM_WING_INV = 6;
public int ANIM_LEG_2    = 7;  // spider second pair phase
public int ANIM_LEG_INV_2= 8;

// ═══════════════════════════════════════════════════════════════════════════
// MobPart — one body piece
// ═══════════════════════════════════════════════════════════════════════════
public class MobPart {
    public string name;
    public Mesh   mesh;
    public float  offsetX; public float offsetY; public float offsetZ;
    public int    anim;        // ANIM_*
    public float  pivotY;      // rotation pivot Y (top of leg, etc.)
    public bool   visible;

    public MobPart(string name, Mesh mesh,
                   float ox, float oy, float oz,
                   int anim, float pivotY) {
        this.name = name; this.mesh = mesh;
        offsetX = ox; offsetY = oy; offsetZ = oz;
        this.anim = anim; this.pivotY = pivotY;
        visible = true;
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// MobModel — collection of parts
// ═══════════════════════════════════════════════════════════════════════════
public class MobModel {
    public MobPart[] parts;
    public int       partCount;
    public float     heightScale;   // overall scale (mob frame is ~1 wide, ~1.5 tall)
    public float     widthScale;

    public MobModel(int maxParts) {
        parts = new MobPart[maxParts];
        partCount = 0;
        heightScale = 1.0;
        widthScale = 1.0;
    }

    public func void addPart(MobPart p) {
        if (partCount >= parts.length()) return;
        parts[partCount] = p;
        partCount++;
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Mesh helpers — build a colored box
// ═══════════════════════════════════════════════════════════════════════════
// Builds a cube mesh with per-face shading baked into vertex colors.
// Box is centered at (0,0,0) but extends in -hw..+hw on x/z and 0..h on y
// (i.e. feet at y=0, head at y=h). Local-space — caller applies offset.
//
// stride=6: [x,y,z, r,g,b]
public func Mesh makeBox(float hw, float h, float hd, float r, float g, float b) {
    // 6 faces × 4 verts × 6 floats = 144
    float[] verts = new float[144];
    int[]   inds  = new int[36];

    // Per-face shading multipliers (top brightest, bottom darkest)
    float[] shade = new float[6];
    shade[0] = 1.00;   // top
    shade[1] = 0.50;   // bottom
    shade[2] = 0.80;   // +X
    shade[3] = 0.70;   // -X
    shade[4] = 0.85;   // +Z
    shade[5] = 0.65;   // -Z

    // 8 corners (cube from (-hw,0,-hd) to (+hw,h,+hd))
    // We list each face's 4 verts explicitly so we can apply per-face shade.

    // Face: top (y=h) — facing +Y
    int f = 0;
    float s = shade[f];
    verts[f*24+0 ]=-hw; verts[f*24+1 ]=h;  verts[f*24+2 ]=-hd; verts[f*24+3 ]=r*s; verts[f*24+4 ]=g*s; verts[f*24+5 ]=b*s;
    verts[f*24+6 ]= hw; verts[f*24+7 ]=h;  verts[f*24+8 ]=-hd; verts[f*24+9 ]=r*s; verts[f*24+10]=g*s; verts[f*24+11]=b*s;
    verts[f*24+12]= hw; verts[f*24+13]=h;  verts[f*24+14]= hd; verts[f*24+15]=r*s; verts[f*24+16]=g*s; verts[f*24+17]=b*s;
    verts[f*24+18]=-hw; verts[f*24+19]=h;  verts[f*24+20]= hd; verts[f*24+21]=r*s; verts[f*24+22]=g*s; verts[f*24+23]=b*s;

    // Face: bottom (y=0) — facing -Y
    f = 1; s = shade[f];
    verts[f*24+0 ]=-hw; verts[f*24+1 ]=0;  verts[f*24+2 ]= hd; verts[f*24+3 ]=r*s; verts[f*24+4 ]=g*s; verts[f*24+5 ]=b*s;
    verts[f*24+6 ]= hw; verts[f*24+7 ]=0;  verts[f*24+8 ]= hd; verts[f*24+9 ]=r*s; verts[f*24+10]=g*s; verts[f*24+11]=b*s;
    verts[f*24+12]= hw; verts[f*24+13]=0;  verts[f*24+14]=-hd; verts[f*24+15]=r*s; verts[f*24+16]=g*s; verts[f*24+17]=b*s;
    verts[f*24+18]=-hw; verts[f*24+19]=0;  verts[f*24+20]=-hd; verts[f*24+21]=r*s; verts[f*24+22]=g*s; verts[f*24+23]=b*s;

    // Face: +X
    f = 2; s = shade[f];
    verts[f*24+0 ]= hw; verts[f*24+1 ]=0;  verts[f*24+2 ]=-hd; verts[f*24+3 ]=r*s; verts[f*24+4 ]=g*s; verts[f*24+5 ]=b*s;
    verts[f*24+6 ]= hw; verts[f*24+7 ]=0;  verts[f*24+8 ]= hd; verts[f*24+9 ]=r*s; verts[f*24+10]=g*s; verts[f*24+11]=b*s;
    verts[f*24+12]= hw; verts[f*24+13]=h;  verts[f*24+14]= hd; verts[f*24+15]=r*s; verts[f*24+16]=g*s; verts[f*24+17]=b*s;
    verts[f*24+18]= hw; verts[f*24+19]=h;  verts[f*24+20]=-hd; verts[f*24+21]=r*s; verts[f*24+22]=g*s; verts[f*24+23]=b*s;

    // Face: -X
    f = 3; s = shade[f];
    verts[f*24+0 ]=-hw; verts[f*24+1 ]=0;  verts[f*24+2 ]= hd; verts[f*24+3 ]=r*s; verts[f*24+4 ]=g*s; verts[f*24+5 ]=b*s;
    verts[f*24+6 ]=-hw; verts[f*24+7 ]=0;  verts[f*24+8 ]=-hd; verts[f*24+9 ]=r*s; verts[f*24+10]=g*s; verts[f*24+11]=b*s;
    verts[f*24+12]=-hw; verts[f*24+13]=h;  verts[f*24+14]=-hd; verts[f*24+15]=r*s; verts[f*24+16]=g*s; verts[f*24+17]=b*s;
    verts[f*24+18]=-hw; verts[f*24+19]=h;  verts[f*24+20]= hd; verts[f*24+21]=r*s; verts[f*24+22]=g*s; verts[f*24+23]=b*s;

    // Face: +Z
    f = 4; s = shade[f];
    verts[f*24+0 ]=-hw; verts[f*24+1 ]=0;  verts[f*24+2 ]= hd; verts[f*24+3 ]=r*s; verts[f*24+4 ]=g*s; verts[f*24+5 ]=b*s;
    verts[f*24+6 ]= hw; verts[f*24+7 ]=0;  verts[f*24+8 ]= hd; verts[f*24+9 ]=r*s; verts[f*24+10]=g*s; verts[f*24+11]=b*s;
    verts[f*24+12]= hw; verts[f*24+13]=h;  verts[f*24+14]= hd; verts[f*24+15]=r*s; verts[f*24+16]=g*s; verts[f*24+17]=b*s;
    verts[f*24+18]=-hw; verts[f*24+19]=h;  verts[f*24+20]= hd; verts[f*24+21]=r*s; verts[f*24+22]=g*s; verts[f*24+23]=b*s;

    // Face: -Z
    f = 5; s = shade[f];
    verts[f*24+0 ]= hw; verts[f*24+1 ]=0;  verts[f*24+2 ]=-hd; verts[f*24+3 ]=r*s; verts[f*24+4 ]=g*s; verts[f*24+5 ]=b*s;
    verts[f*24+6 ]=-hw; verts[f*24+7 ]=0;  verts[f*24+8 ]=-hd; verts[f*24+9 ]=r*s; verts[f*24+10]=g*s; verts[f*24+11]=b*s;
    verts[f*24+12]=-hw; verts[f*24+13]=h;  verts[f*24+14]=-hd; verts[f*24+15]=r*s; verts[f*24+16]=g*s; verts[f*24+17]=b*s;
    verts[f*24+18]= hw; verts[f*24+19]=h;  verts[f*24+20]=-hd; verts[f*24+21]=r*s; verts[f*24+22]=g*s; verts[f*24+23]=b*s;

    // Indices (each face = 2 triangles, 6 indices)
    for (f = 0; f < 6; f++) {
        int v = f * 4;
        int i = f * 6;
        inds[i+0] = v + 0;
        inds[i+1] = v + 1;
        inds[i+2] = v + 2;
        inds[i+3] = v + 2;
        inds[i+4] = v + 3;
        inds[i+5] = v + 0;
    }

    return Mesh.Create(verts, inds, 6);
}

// ═══════════════════════════════════════════════════════════════════════════
// Mob model builders — one per mob type
// ═══════════════════════════════════════════════════════════════════════════
// Mob type IDs (kept as ints — same pattern as block ids)
public int MOB_PIG     = 0;
public int MOB_COW     = 1;
public int MOB_CHICKEN = 2;
public int MOB_SHEEP   = 3;
public int MOB_ZOMBIE  = 4;
public int MOB_SKELETON= 5;
public int MOB_SPIDER  = 6;
public int MOB_CREEPER = 7;
public int MOB_PLAYER  = 8;
public int MOB_MAX     = 9;

// ── Pig: pink body + head + 4 short legs + snout ────────────────────────────
public func MobModel buildPigModel() {
    MobModel m = new MobModel(8);
    float pinkR = 0.90; float pinkG = 0x70/255.0; float pinkB = 0x75/255.0;  // ~#f0a0a5
    float darkR = 0xE0/255.0; float darkG = 0x88/255.0; float darkB = 0x88/255.0;

    // Body: 0.8 wide, 0.5 tall, 1.0 long — centered on origin
    Mesh body = makeBox(0.35, 0.45, 0.45, pinkR, pinkG, pinkB);
    m.addPart(new MobPart("body", body, 0.0, 0.20, 0.0, ANIM_BODY_BOB, 0.0));

    // Head: 0.4 cube, sits at front of body
    Mesh head = makeBox(0.20, 0.35, 0.20, pinkR, pinkG, pinkB);
    m.addPart(new MobPart("head", head, 0.0, 0.30, -0.45, ANIM_HEAD, 0.0));

    // Snout: small dark-pink box on front of head
    Mesh snout = makeBox(0.10, 0.12, 0.05, darkR, darkG, darkB);
    m.addPart(new MobPart("snout", snout, 0.0, 0.36, -0.62, ANIM_NONE, 0.0));

    // Legs (4): short, thin. Pivot at top of leg (where it joins body).
    float legW = 0.08; float legH = 0.20;
    Mesh leg = makeBox(legW, legH, legW, pinkR*0.85, pinkG*0.85, pinkB*0.85);
    // Front legs
    m.addPart(new MobPart("legFL", leg, -0.22, 0.05, -0.30, ANIM_LEG, legH));
    m.addPart(new MobPart("legFR", leg,  0.22, 0.05, -0.30, ANIM_LEG_INV, legH));
    // Back legs
    m.addPart(new MobPart("legBL", leg, -0.22, 0.05,  0.30, ANIM_LEG_INV, legH));
    m.addPart(new MobPart("legBR", leg,  0.22, 0.05,  0.30, ANIM_LEG, legH));

    m.widthScale = 1.0;
    m.heightScale = 1.0;
    return m;
}

// ── Cow: brown/white body + head + 4 legs + horns ───────────────────────────
public func MobModel buildCowModel() {
    MobModel m = new MobModel(8);
    float brownR = 0.40; float brownG = 0.27; float brownB = 0.15;
    float whiteR = 0.92; float whiteG = 0.90; float whiteB = 0.85;

    // Body
    Mesh body = makeBox(0.40, 0.55, 0.55, brownR, brownG, brownB);
    m.addPart(new MobPart("body", body, 0.0, 0.25, 0.0, ANIM_BODY_BOB, 0.0));

    // Head
    Mesh head = makeBox(0.22, 0.38, 0.22, whiteR, whiteG, whiteB);
    m.addPart(new MobPart("head", head, 0.0, 0.45, -0.55, ANIM_HEAD, 0.0));

    // Horns (small white bumps)
    Mesh horn = makeBox(0.04, 0.08, 0.04, 0.95, 0.92, 0.85);
    m.addPart(new MobPart("hornL", horn, -0.18, 0.80, -0.50, ANIM_NONE, 0.0));
    m.addPart(new MobPart("hornR", horn,  0.18, 0.80, -0.50, ANIM_NONE, 0.0));

    // Legs
    float legW = 0.10; float legH = 0.30;
    Mesh leg = makeBox(legW, legH, legW, brownR*0.8, brownG*0.8, brownB*0.8);
    m.addPart(new MobPart("legFL", leg, -0.28, 0.05, -0.35, ANIM_LEG, legH));
    m.addPart(new MobPart("legFR", leg,  0.28, 0.05, -0.35, ANIM_LEG_INV, legH));
    m.addPart(new MobPart("legBL", leg, -0.28, 0.05,  0.35, ANIM_LEG_INV, legH));
    m.addPart(new MobPart("legBR", leg,  0.28, 0.05,  0.35, ANIM_LEG, legH));

    m.widthScale = 1.05;
    m.heightScale = 1.10;
    return m;
}

// ── Chicken: small white body + head + comb + beak + 2 legs + wings ─────────
public func MobModel buildChickenModel() {
    MobModel m = new MobModel(8);
    float whiteR = 0.95; float whiteG = 0.95; float whiteB = 0.92;
    float redR = 0.90; float redG = 0.15; float redB = 0.15;
    float yellowR = 0.90; float yellowG = 0.75; float yellowB = 0.15;

    // Body (small, rounder)
    Mesh body = makeBox(0.18, 0.22, 0.22, whiteR, whiteG, whiteB);
    m.addPart(new MobPart("body", body, 0.0, 0.18, 0.0, ANIM_BODY_BOB, 0.0));

    // Head (small)
    Mesh head = makeBox(0.10, 0.14, 0.10, whiteR, whiteG, whiteB);
    m.addPart(new MobPart("head", head, 0.0, 0.40, -0.18, ANIM_HEAD, 0.0));

    // Comb (red crest on top of head)
    Mesh comb = makeBox(0.06, 0.04, 0.08, redR, redG, redB);
    m.addPart(new MobPart("comb", comb, 0.0, 0.54, -0.18, ANIM_NONE, 0.0));

    // Beak (yellow, small)
    Mesh beak = makeBox(0.05, 0.04, 0.04, yellowR, yellowG, yellowB);
    m.addPart(new MobPart("beak", beak, 0.0, 0.44, -0.27, ANIM_NONE, 0.0));

    // Wings (thin boxes on sides of body)
    Mesh wing = makeBox(0.04, 0.16, 0.18, whiteR*0.92, whiteG*0.92, whiteB*0.92);
    m.addPart(new MobPart("wingL", wing, -0.20, 0.22, 0.0, ANIM_WING, 0.16));
    m.addPart(new MobPart("wingR", wing,  0.20, 0.22, 0.0, ANIM_WING_INV, 0.16));

    // Legs (orange, thin)
    Mesh leg = makeBox(0.03, 0.18, 0.03, yellowR, yellowG, yellowB);
    m.addPart(new MobPart("legFL", leg, -0.06, 0.02, -0.05, ANIM_LEG, 0.18));
    m.addPart(new MobPart("legFR", leg,  0.06, 0.02, -0.05, ANIM_LEG_INV, 0.18));

    m.widthScale = 0.65;
    m.heightScale = 0.65;
    return m;
}

// ── Sheep: white wool body + dark head + 4 legs ─────────────────────────────
public func MobModel buildSheepModel() {
    MobModel m = new MobModel(8);
    float woolR = 0.92; float woolG = 0.92; float woolB = 0.92;
    float faceR = 0.30; float faceG = 0.25; float faceB = 0.22;

    // Wool body (slightly larger, rounded look)
    Mesh body = makeBox(0.40, 0.50, 0.50, woolR, woolG, woolB);
    m.addPart(new MobPart("body", body, 0.0, 0.22, 0.0, ANIM_BODY_BOB, 0.0));

    // Head (dark, smaller)
    Mesh head = makeBox(0.18, 0.25, 0.18, faceR, faceG, faceB);
    m.addPart(new MobPart("head", head, 0.0, 0.40, -0.45, ANIM_HEAD, 0.0));

    // Legs (dark, thin)
    Mesh leg = makeBox(0.08, 0.22, 0.08, faceR*0.9, faceG*0.9, faceB*0.9);
    m.addPart(new MobPart("legFL", leg, -0.26, 0.05, -0.30, ANIM_LEG, 0.22));
    m.addPart(new MobPart("legFR", leg,  0.26, 0.05, -0.30, ANIM_LEG_INV, 0.22));
    m.addPart(new MobPart("legBL", leg, -0.26, 0.05,  0.30, ANIM_LEG_INV, 0.22));
    m.addPart(new MobPart("legBR", leg,  0.26, 0.05,  0.30, ANIM_LEG, 0.22));

    m.widthScale = 0.95;
    m.heightScale = 0.95;
    return m;
}

// ── Zombie: green humanoid body + head + 2 arms + 2 legs ───────────────────
public func MobModel buildZombieModel() {
    MobModel m = new MobModel(8);
    float skinR = 0.45; float skinG = 0.65; float skinB = 0.40;  // zombie green
    float shirtR = 0.20; float shirtG = 0.30; float shirtB = 0.55; // torn shirt
    float pantsR = 0.25; float pantsG = 0.22; float pantsB = 0.20;  // dark pants

    // Body (torso) — shirt-colored
    Mesh body = makeBox(0.22, 0.50, 0.12, shirtR, shirtG, shirtB);
    m.addPart(new MobPart("body", body, 0.0, 0.55, 0.0, ANIM_BODY_BOB, 0.0));

    // Head
    Mesh head = makeBox(0.18, 0.18, 0.18, skinR, skinG, skinB);
    m.addPart(new MobPart("head", head, 0.0, 1.05, 0.0, ANIM_HEAD, 0.0));

    // Arms (raised zombie-style: rotate forward)
    Mesh arm = makeBox(0.07, 0.40, 0.07, skinR, skinG, skinB);
    m.addPart(new MobPart("armL", arm, -0.27, 0.95, -0.15, ANIM_LEG, 0.40));      // forward swing
    m.addPart(new MobPart("armR", arm,  0.27, 0.95, -0.15, ANIM_LEG_INV, 0.40));

    // Legs
    Mesh leg = makeBox(0.09, 0.50, 0.09, pantsR, pantsG, pantsB);
    m.addPart(new MobPart("legL", leg, -0.12, 0.05, 0.0, ANIM_LEG, 0.50));
    m.addPart(new MobPart("legR", leg,  0.12, 0.05, 0.0, ANIM_LEG_INV, 0.50));

    m.widthScale = 1.0;
    m.heightScale = 1.7;
    return m;
}

// ── Skeleton: white humanoid body + head + bow arm + 2 legs ────────────────
public func MobModel buildSkeletonModel() {
    MobModel m = new MobModel(8);
    float boneR = 0.85; float boneG = 0.85; float boneB = 0.80;
    float darkR = 0.40; float darkG = 0.40; float darkB = 0.45;

    // Body (ribcage-ish, narrow)
    Mesh body = makeBox(0.16, 0.50, 0.10, boneR, boneG, boneB);
    m.addPart(new MobPart("body", body, 0.0, 0.55, 0.0, ANIM_BODY_BOB, 0.0));

    // Head (skull)
    Mesh head = makeBox(0.18, 0.18, 0.18, boneR*1.05, boneG*1.05, boneB*1.05);
    m.addPart(new MobPart("head", head, 0.0, 1.05, 0.0, ANIM_HEAD, 0.0));

    // Arms (one holding bow forward, other swinging)
    Mesh arm = makeBox(0.06, 0.42, 0.06, boneR, boneG, boneB);
    m.addPart(new MobPart("armL", arm, -0.22, 0.92, -0.10, ANIM_NONE, 0.0));    // bow arm forward
    m.addPart(new MobPart("armR", arm,  0.22, 0.92, 0.0, ANIM_LEG_INV, 0.42));

    // Legs
    Mesh leg = makeBox(0.07, 0.50, 0.07, boneR*0.92, boneG*0.92, boneB*0.92);
    m.addPart(new MobPart("legL", leg, -0.10, 0.05, 0.0, ANIM_LEG, 0.50));
    m.addPart(new MobPart("legR", leg,  0.10, 0.05, 0.0, ANIM_LEG_INV, 0.50));

    m.widthScale = 0.95;
    m.heightScale = 1.75;
    return m;
}

// ── Spider: black body + head + 8 legs ──────────────────────────────────────
public func MobModel buildSpiderModel() {
    MobModel m = new MobModel(12);
    float blackR = 0.18; float blackG = 0.15; float blackB = 0.20;
    float redR = 0.65; float redG = 0.10; float redB = 0.10;

    // Body (two-segment: abdomen + cephalothorax)
    Mesh body = makeBox(0.30, 0.25, 0.40, blackR, blackG, blackB);
    m.addPart(new MobPart("body", body, 0.0, 0.18, 0.10, ANIM_BODY_BOB, 0.0));

    // Head (front segment)
    Mesh head = makeBox(0.22, 0.20, 0.22, blackR*1.1, blackG*1.1, blackB*1.1);
    m.addPart(new MobPart("head", head, 0.0, 0.20, -0.20, ANIM_HEAD, 0.0));

    // 8 legs (4 per side). Pivot at top (where leg joins body).
    Mesh leg = makeBox(0.05, 0.30, 0.05, blackR, blackG, blackB);
    // Left side: front to back
    m.addPart(new MobPart("legL1", leg, -0.28, 0.20, -0.18, ANIM_LEG,       0.30));
    m.addPart(new MobPart("legL2", leg, -0.28, 0.20, -0.06, ANIM_LEG_2,     0.30));
    m.addPart(new MobPart("legL3", leg, -0.28, 0.20,  0.06, ANIM_LEG_INV_2, 0.30));
    m.addPart(new MobPart("legL4", leg, -0.28, 0.20,  0.18, ANIM_LEG_INV,   0.30));
    // Right side: front to back (opposite phases)
    m.addPart(new MobPart("legR1", leg,  0.28, 0.20, -0.18, ANIM_LEG_INV,   0.30));
    m.addPart(new MobPart("legR2", leg,  0.28, 0.20, -0.06, ANIM_LEG_INV_2, 0.30));
    m.addPart(new MobPart("legR3", leg,  0.28, 0.20,  0.06, ANIM_LEG_2,     0.30));
    m.addPart(new MobPart("legR4", leg,  0.28, 0.20,  0.18, ANIM_LEG,       0.30));

    // Red eye spots on head
    Mesh eye = makeBox(0.03, 0.03, 0.02, redR, redG, redB);
    m.addPart(new MobPart("eyeL", eye, -0.06, 0.32, -0.30, ANIM_NONE, 0.0));
    m.addPart(new MobPart("eyeR", eye,  0.06, 0.32, -0.30, ANIM_NONE, 0.0));

    m.widthScale = 1.1;
    m.heightScale = 0.75;
    return m;
}

// ── Creeper: green upright body + 4 short legs ──────────────────────────────
public func MobModel buildCreeperModel() {
    MobModel m = new MobModel(8);
    float creeperR = 0.55; float creeperG = 0.75; float creeperB = 0.30;
    float darkR = 0.30; float darkG = 0.50; float darkB = 0.15;

    // Body (tall narrow green)
    Mesh body = makeBox(0.20, 0.55, 0.12, creeperR, creeperG, creeperB);
    m.addPart(new MobPart("body", body, 0.0, 0.50, 0.0, ANIM_BODY_BOB, 0.0));

    // Head (slightly wider than body)
    Mesh head = makeBox(0.22, 0.22, 0.22, creeperR*1.05, creeperG*1.05, creeperB*1.05);
    m.addPart(new MobPart("head", head, 0.0, 1.05, 0.0, ANIM_HEAD, 0.0));

    // Face (darker green patches for eyes — single box approximates)
    Mesh face = makeBox(0.18, 0.10, 0.02, darkR, darkG, darkB);
    m.addPart(new MobPart("face", face, 0.0, 1.10, -0.115, ANIM_NONE, 0.0));

    // 4 short legs
    Mesh leg = makeBox(0.10, 0.18, 0.10, darkR, darkG, darkB);
    m.addPart(new MobPart("legFL", leg, -0.15, 0.05, -0.05, ANIM_LEG,      0.18));
    m.addPart(new MobPart("legFR", leg,  0.15, 0.05, -0.05, ANIM_LEG_INV,  0.18));
    m.addPart(new MobPart("legBL", leg, -0.15, 0.05,  0.05, ANIM_LEG_INV,  0.18));
    m.addPart(new MobPart("legBR", leg,  0.15, 0.05,  0.05, ANIM_LEG,      0.18));

    m.widthScale = 0.95;
    m.heightScale = 1.45;
    return m;
}

// ── Player model (for inventory preview) — like skeleton but skin-toned ─────
public func MobModel buildPlayerModel() {
    MobModel m = new MobModel(8);
    float skinR = 0.85; float skinG = 0.70; float skinB = 0.55;
    float shirtR = 0.20; float shirtG = 0.45; float shirtB = 0.75;  // blue shirt
    float pantsR = 0.30; float pantsG = 0.25; float pantsB = 0.20;

    // Body
    Mesh body = makeBox(0.22, 0.55, 0.12, shirtR, shirtG, shirtB);
    m.addPart(new MobPart("body", body, 0.0, 0.55, 0.0, ANIM_NONE, 0.0));

    // Head
    Mesh head = makeBox(0.20, 0.20, 0.20, skinR, skinG, skinB);
    m.addPart(new MobPart("head", head, 0.0, 1.10, 0.0, ANIM_NONE, 0.0));

    // Arms (idle)
    Mesh arm = makeBox(0.07, 0.50, 0.07, shirtR, shirtG, shirtB);
    m.addPart(new MobPart("armL", arm, -0.27, 0.55, 0.0, ANIM_NONE, 0.0));
    m.addPart(new MobPart("armR", arm,  0.27, 0.55, 0.0, ANIM_NONE, 0.0));

    // Legs
    Mesh leg = makeBox(0.09, 0.55, 0.09, pantsR, pantsG, pantsB);
    m.addPart(new MobPart("legL", leg, -0.12, 0.0, 0.0, ANIM_NONE, 0.0));
    m.addPart(new MobPart("legR", leg,  0.12, 0.0, 0.0, ANIM_NONE, 0.0));

    m.widthScale = 1.0;
    m.heightScale = 1.8;
    return m;
}

// ── Central registry: maps mob type id -> MobModel ───────────────────────────
public class MobModelRegistry {
    public MobModel[] models;
    public bool[]      built;

    public MobModelRegistry() {
        models = new MobModel[MOB_MAX];
        built  = new bool[MOB_MAX];
        for (int i = 0; i < MOB_MAX; i++) built[i] = false;
    }

    public func MobModel get(int mobType) {
        if (mobType < 0 || mobType >= MOB_MAX) return null;
        if (!built[mobType]) {
            if      (mobType == MOB_PIG)      models[mobType] = buildPigModel();
            else if (mobType == MOB_COW)      models[mobType] = buildCowModel();
            else if (mobType == MOB_CHICKEN)  models[mobType] = buildChickenModel();
            else if (mobType == MOB_SHEEP)    models[mobType] = buildSheepModel();
            else if (mobType == MOB_ZOMBIE)   models[mobType] = buildZombieModel();
            else if (mobType == MOB_SKELETON) models[mobType] = buildSkeletonModel();
            else if (mobType == MOB_SPIDER)   models[mobType] = buildSpiderModel();
            else if (mobType == MOB_CREEPER)  models[mobType] = buildCreeperModel();
            else if (mobType == MOB_PLAYER)   models[mobType] = buildPlayerModel();
            built[mobType] = true;
        }
        return models[mobType];
    }
}

public MobModelRegistry MobModels = new MobModelRegistry();

// ── Compute per-part model matrix ────────────────────────────────────────────
// mob matrix = translate(mob.x - 0.5, mob.y, mob.z - 0.5) * scale(s, s, s)
//              * rotateY(facing) * translate(part.offset) * partAnim
//
// To keep this simple, we expose a helper that returns the per-part MVP
// (vp * modelMatrix) given the part and the mob's pose.
public func Matrix4x4 computePartMatrix(
    MobPart part,
    double mobX, double mobY, double mobZ,
    float facingYaw,
    float walkPhase,
    float walkAmp,
    float modelScale
) {
    // 1. Translate to mob position
    Matrix4x4 m = Matrix4x4.translation(
        cast<float>(mobX),
        cast<float>(mobY),
        cast<float>(mobZ)
    );

    // 2. Rotate around Y to face movement direction
    m = m * Matrix4x4.rotationY(facingYaw);

    // 3. Scale the whole model
    m = m * Matrix4x4.scale(modelScale, modelScale, modelScale);

    // 4. Apply per-part offset
    m = m * Matrix4x4.translation(part.offsetX, part.offsetY, part.offsetZ);

    // 5. Apply per-part animation (rotation around X at pivot)
    if (part.anim == ANIM_LEG || part.anim == ANIM_LEG_INV ||
        part.anim == ANIM_LEG_2 || part.anim == ANIM_LEG_INV_2) {
        float phase = walkPhase;
        if (part.anim == ANIM_LEG_INV)   phase = -walkPhase;
        if (part.anim == ANIM_LEG_2)     phase = walkPhase + 1.5708;
        if (part.anim == ANIM_LEG_INV_2) phase = -walkPhase + 1.5708;
        float angle = Math.sin(phase) * walkAmp;
        // Translate pivot to origin, rotate, translate back
        m = m * Matrix4x4.translation(0.0, part.pivotY, 0.0);
        m = m * Matrix4x4.rotationX(angle);
        m = m * Matrix4x4.translation(0.0, -part.pivotY, 0.0);
    } else if (part.anim == ANIM_HEAD) {
        float angle = Math.sin(walkPhase * 0.5) * 0.10 * walkAmp;
        m = m * Matrix4x4.translation(0.0, part.pivotY, 0.0);
        m = m * Matrix4x4.rotationX(angle);
        m = m * Matrix4x4.translation(0.0, -part.pivotY, 0.0);
    } else if (part.anim == ANIM_BODY_BOB) {
        float bob = Math.abs(Math.sin(walkPhase)) * 0.04 * walkAmp;
        m = m * Matrix4x4.translation(0.0, bob, 0.0);
    } else if (part.anim == ANIM_WING || part.anim == ANIM_WING_INV) {
        float phase = walkPhase * 2.5;
        if (part.anim == ANIM_WING_INV) phase = -phase;
        float angle = Math.sin(phase) * 0.7;
        m = m * Matrix4x4.translation(0.0, part.pivotY, 0.0);
        m = m * Matrix4x4.rotationZ(angle);
        m = m * Matrix4x4.translation(0.0, -part.pivotY, 0.0);
    }

    return m;
}
