// ═══════════════════════════════════════════════════════════════════════════
// renderer.ume — Shader loading (from .glsl files) + texture atlas
// ═══════════════════════════════════════════════════════════════════════════
//
// Shader sources are loaded from src/shaders/*.vert / *.frag at startup.
// If the file can't be read, we fall back to embedded strings so the game
// still runs even if the shader files are missing.

import std.math.*;

// ── Path helpers ─────────────────────────────────────────────────────────────
public func string shaderPath(string name) { return "src/shaders/" + name; }

// ── Embedded fallback shaders (used if file is missing) ─────────────────────
private func string fallbackTerrainVert() {
    return "#version 410 core\n"
        + "layout(location=0) in vec3 aPos;\n"
        + "layout(location=1) in vec3 aExtra;\n"
        + "layout(location=2) in vec2 aUV;\n"
        + "uniform mat4 mvp;\n"
        + "uniform mat4 uModel;\n"
        + "out vec2 vUV;\n"
        + "out float vAO;\n"
        + "out vec3 vPos;\n"
        + "void main() {\n"
        + "  vec4 worldPos = uModel * vec4(aPos, 1.0);\n"
        + "  gl_Position = mvp * worldPos;\n"
        + "  vUV = aUV;\n"
        + "  vAO = aExtra.x;\n"
        + "  vPos = worldPos.xyz;\n"
        + "}\n";
}

private func string fallbackTerrainFrag() {
    return "#version 410 core\n"
        + "in vec2 vUV;\n"
        + "in float vAO;\n"
        + "in vec3 vPos;\n"
        + "uniform sampler2D uAtlas;\n"
        + "uniform int uUseTexture;\n"
        + "uniform vec3 uFlatColor;\n"
        + "uniform vec3 camPos;\n"
        + "uniform vec3 fogColor;\n"
        + "uniform vec3 uLightDir;\n"
        + "uniform float uLightStrength;\n"
        + "uniform float uMinLight;\n"
        + "out vec4 FragColor;\n"
        + "void main() {\n"
        + "  vec3 baseCol;\n"
        + "  if (uUseTexture != 0) { baseCol = texture(uAtlas, vUV).rgb; }\n"
        + "  else { baseCol = uFlatColor; }\n"
        + "  float light = vAO * uLightStrength;\n"
        + "  light = max(light, uMinLight);\n"
        + "  vec3 col = baseCol * light;\n"
        + "  float dist = length(vPos - camPos);\n"
        + "  float fog = clamp((dist - 24.0) / 22.0, 0.0, 0.78);\n"
        + "  FragColor = vec4(mix(col, fogColor, fog), 1.0);\n"
        + "}\n";
}

private func string fallbackHUDVert() {
    return "#version 410 core\n"
        + "layout(location=0) in vec3 aPos;\n"
        + "uniform vec4 uRect;\n"
        + "uniform float uScreenW;\n"
        + "uniform float uScreenH;\n"
        + "uniform float uUVScale;\n"
        + "out vec2 vUV;\n"
        + "void main() {\n"
        + "  float u = aPos.x + 0.5;\n"
        + "  float v = aPos.y + 0.5;\n"
        + "  float nx = (uRect.x + u * uRect.z) / uScreenW * 2.0 - 1.0;\n"
        + "  float ny = 1.0 - (uRect.y + (1.0 - v) * uRect.w) / uScreenH * 2.0;\n"
        + "  gl_Position = vec4(nx, ny, 0.0, 1.0);\n"
        + "  vUV = vec2(u * uUVScale, (1.0 - v) * uUVScale);\n"
        + "}\n";
}

private func string fallbackHUDFrag() {
    return "#version 410 core\n"
        + "in vec2 vUV;\n"
        + "uniform vec4 uColor;\n"
        + "uniform int uUseTexture;\n"
        + "uniform sampler2D uTex;\n"
        + "out vec4 FragColor;\n"
        + "void main() {\n"
        + "  if (uUseTexture != 0) { FragColor = texture(uTex, vUV) * uColor; }\n"
        + "  else { FragColor = uColor; }\n"
        + "}\n";
}

private func string fallbackMobVert() {
    return "#version 410 core\n"
        + "layout(location=0) in vec3 aPos;\n"
        + "layout(location=1) in vec3 aColor;\n"
        + "uniform mat4 mvp;\n"
        + "uniform mat4 uModel;\n"
        + "out vec3 vColor;\n"
        + "out vec3 vPos;\n"
        + "void main() {\n"
        + "  vec4 worldPos = uModel * vec4(aPos, 1.0);\n"
        + "  gl_Position = mvp * worldPos;\n"
        + "  vColor = aColor;\n"
        + "  vPos = worldPos.xyz;\n"
        + "}\n";
}

private func string fallbackMobFrag() {
    return "#version 410 core\n"
        + "in vec3 vColor;\n"
        + "in vec3 vPos;\n"
        + "uniform vec3 camPos;\n"
        + "uniform vec3 fogColor;\n"
        + "uniform vec3 uLightDir;\n"
        + "uniform float uLightStrength;\n"
        + "uniform float uMinLight;\n"
        + "out vec4 FragColor;\n"
        + "void main() {\n"
        + "  float light = uLightStrength * (0.65 + 0.35 * clamp(vPos.y * 0.1 + 0.5, 0.0, 1.0));\n"
        + "  light = max(light, uMinLight);\n"
        + "  vec3 col = vColor * light;\n"
        + "  float fog = clamp((length(vPos - camPos) - 20.0) / 18.0, 0.0, 0.72);\n"
        + "  FragColor = vec4(mix(col, fogColor, fog), 1.0);\n"
        + "}\n";
}

// ── Read a shader source from file with fallback ────────────────────────────
private func string loadShaderSource(string path, string fallback) {
    string src = FileSystem.readText(path);
    if (src.length() == 0) return fallback;
    return src;
}

// ── Build terrain shader from external files ────────────────────────────────
public func Shader buildTerrainShader() {
    string tv = loadShaderSource(shaderPath("terrain.vert"), fallbackTerrainVert());
    string tf = loadShaderSource(shaderPath("terrain.frag"), fallbackTerrainFrag());
    return new Shader(tv, tf);
}

// ── Build HUD shader ─────────────────────────────────────────────────────────
public func Shader buildHUDShader() {
    string hv = loadShaderSource(shaderPath("hud.vert"), fallbackHUDVert());
    string hf = loadShaderSource(shaderPath("hud.frag"), fallbackHUDFrag());
    return new Shader(hv, hf);
}

// ── Build mob shader ─────────────────────────────────────────────────────────
public func Shader buildMobShader() {
    string mv = loadShaderSource(shaderPath("mob.vert"), fallbackMobVert());
    string mf = loadShaderSource(shaderPath("mob.frag"), fallbackMobFrag());
    return new Shader(mv, mf);
}

// ═══════════════════════════════════════════════════════════════════════════
// Texture atlas loader
// ═══════════════════════════════════════════════════════════════════════════
// Atlas layout (5×3 = 15 tiles, 80×48 px):
//   (0,0) grass_top    (1,0) grass_side   (2,0) dirt         (3,0) stone        (4,0) cobble
//   (0,1) sand         (1,1) gravel       (2,1) planks       (3,1) log_side     (4,1) log_top
//   (0,2) leaves       (1,2) snow         (2,2) water        (3,2) bedrock      (4,2) fallback

public func Texture loadTextureAtlas(string basePath) {
    int atlasCols = ATLAS_COLS;
    int atlasRows = ATLAS_ROWS;
    int tileW     = 16;
    int tileH     = 16;
    int atlasW    = atlasCols * tileW;
    int atlasH    = atlasRows * tileH;
    int totalPixels = atlasW * atlasH * 4;

    int[] atlasPixels = new int[totalPixels];
    for (int i = 0; i < totalPixels; i++) {
        if (i % 4 == 3) atlasPixels[i] = 255;
        else atlasPixels[i] = 128;
    }

    // ── Procedural fallback colors (used if PNG missing) ─────────────────────
    float[] tileColors = new float[atlasCols * atlasRows * 3];
    tileColors[0]=0.34; tileColors[1]=0.76; tileColors[2]=0.26;
    tileColors[3]=0.32; tileColors[4]=0.60; tileColors[5]=0.24;
    tileColors[6]=0.52; tileColors[7]=0.36; tileColors[8]=0.20;
    tileColors[9]=0.56; tileColors[10]=0.55; tileColors[11]=0.58;
    tileColors[12]=0.50; tileColors[13]=0.50; tileColors[14]=0.52;
    tileColors[15]=0.80; tileColors[16]=0.73; tileColors[17]=0.46;
    tileColors[18]=0.48; tileColors[19]=0.45; tileColors[20]=0.43;
    tileColors[21]=0.73; tileColors[22]=0.58; tileColors[23]=0.32;
    tileColors[24]=0.38; tileColors[25]=0.27; tileColors[26]=0.10;
    tileColors[27]=0.45; tileColors[28]=0.33; tileColors[29]=0.12;
    tileColors[30]=0.22; tileColors[31]=0.50; tileColors[32]=0.17;
    tileColors[33]=0.92; tileColors[34]=0.94; tileColors[35]=0.98;
    tileColors[36]=0.20; tileColors[37]=0.40; tileColors[38]=0.85;
    tileColors[39]=0.15; tileColors[40]=0.15; tileColors[41]=0.15;
    tileColors[42]=0.50; tileColors[43]=0.50; tileColors[44]=0.50;

    for (int tileRow = 0; tileRow < atlasRows; tileRow++) {
        for (int tileCol = 0; tileCol < atlasCols; tileCol++) {
            int ci = (tileRow * atlasCols + tileCol) * 3;
            int tr = cast<int>(tileColors[ci]   * 255.0);
            int tg = cast<int>(tileColors[ci+1] * 255.0);
            int tb = cast<int>(tileColors[ci+2] * 255.0);
            for (int py = 0; py < tileH; py++) {
                for (int px = 0; px < tileW; px++) {
                    int atlasX = tileCol * tileW + px;
                    int atlasY = tileRow * tileH + py;
                    int idx = (atlasY * atlasW + atlasX) * 4;
                    bool checker = ((px / 4 + py / 4) % 2 == 0);
                    int shade = checker ? 240 : 200;
                    atlasPixels[idx]   = cast<int>(cast<float>(tr) * cast<float>(shade) / 255.0);
                    atlasPixels[idx+1] = cast<int>(cast<float>(tg) * cast<float>(shade) / 255.0);
                    atlasPixels[idx+2] = cast<int>(cast<float>(tb) * cast<float>(shade) / 255.0);
                    atlasPixels[idx+3] = 255;
                }
            }
        }
    }

    // ── Overlay real PNG textures where available ───────────────────────────
    string[] texNames = new string[atlasCols * atlasRows];
    texNames[0]  = basePath + "grass_top.png";
    texNames[1]  = basePath + "grass_side.png";
    texNames[2]  = basePath + "dirt.png";
    texNames[3]  = basePath + "stone.png";
    texNames[4]  = basePath + "cobblestone.png";
    texNames[5]  = basePath + "sand.png";
    texNames[6]  = basePath + "gravel.png";
    texNames[7]  = basePath + "planks.png";
    texNames[8]  = basePath + "log_side.png";
    texNames[9]  = basePath + "log_top.png";
    texNames[10] = basePath + "leaves.png";
    texNames[11] = basePath + "snow.png";
    texNames[12] = basePath + "water.png";
    texNames[13] = basePath + "bedrock.png";
    texNames[14] = basePath + "stone.png";

    for (int tileRow = 0; tileRow < atlasRows; tileRow++) {
        for (int tileCol = 0; tileCol < atlasCols; tileCol++) {
            int tileIndex = tileRow * atlasCols + tileCol;
            string path = texNames[tileIndex];
            int[] imgData = Graphics.loadImagePixels(path);
            if (imgData.length() >= 2 + 16 * 16 * 4) {
                int imgW = imgData[0];
                int imgH = imgData[1];
                for (int py = 0; py < tileH && py < imgH; py++) {
                    for (int px = 0; px < tileW && px < imgW; px++) {
                        int srcIdx = 2 + (py * imgW + px) * 4;
                        int atlasX = tileCol * tileW + px;
                        int atlasY = tileRow * tileH + py;
                        int destIdx = (atlasY * atlasW + atlasX) * 4;
                        atlasPixels[destIdx]   = imgData[srcIdx];
                        atlasPixels[destIdx+1] = imgData[srcIdx+1];
                        atlasPixels[destIdx+2] = imgData[srcIdx+2];
                        atlasPixels[destIdx+3] = imgData[srcIdx+3];
                    }
                }
            }
        }
    }

    return new Texture(atlasW, atlasH, atlasPixels, 4);
}

// ── Individual texture loader (kept for backward compatibility) ──────────────
public func Texture loadBlockTexture(string path, float fr, float fg, float fb) {
    any nativeTex = Graphics.createTexture(path);
    if (nativeTex != null) {
        return new Texture(nativeTex);
    }
    int[] pix = new int[16 * 16 * 4];
    for (int i = 0; i < 16 * 16; i++) {
        int idx = i * 4;
        pix[idx]   = cast<int>(fr * 255.0);
        pix[idx+1] = cast<int>(fg * 255.0);
        pix[idx+2] = cast<int>(fb * 255.0);
        pix[idx+3] = 255;
    }
    return new Texture(16, 16, pix, 4);
}
