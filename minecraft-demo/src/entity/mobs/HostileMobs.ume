// ═══════════════════════════════════════════════════════════════════════════
// HostileMobs.ume — Hostile monster mob entity classes and PlayerEntity
// ═══════════════════════════════════════════════════════════════════════════

// (Mob, PassiveGoals, CombatGoals, and MobPart are included before this file)

public class MonsterEntity extends Mob {
    public MonsterEntity(double x, double y, double z, int type) {
        super(x, y, z, type);
    }

    @Override
    public func void registerGoals() {
        goalSelector.addGoal(0, new FloatGoal(this));
        goalSelector.addGoal(1, new TargetPlayerGoal(this, 16.0));
        goalSelector.addGoal(2, new MeleeAttackGoal(this, 0.045, 1.3));
        goalSelector.addGoal(3, new RandomStrollGoal(this, 0.022));
        goalSelector.addGoal(4, new LookAtPlayerGoal(this, 8.0));
    }
}

public class ZombieEntity extends MonsterEntity {
    public ZombieEntity(double x, double y, double z) {
        super(x, y, z, MOB_ZOMBIE);
        registerGoals();
    }
}

public class SkeletonEntity extends MonsterEntity {
    public SkeletonEntity(double x, double y, double z) {
        super(x, y, z, MOB_SKELETON);
        registerGoals();
    }

    @Override
    public func void registerGoals() {
        goalSelector.addGoal(0, new FloatGoal(this));
        goalSelector.addGoal(1, new TargetPlayerGoal(this, 16.0));
        goalSelector.addGoal(2, new MeleeAttackGoal(this, 0.042, 6.0));
        goalSelector.addGoal(3, new RandomStrollGoal(this, 0.022));
        goalSelector.addGoal(4, new LookAtPlayerGoal(this, 10.0));
    }
}

public class SpiderEntity extends MonsterEntity {
    public SpiderEntity(double x, double y, double z) {
        super(x, y, z, MOB_SPIDER);
        registerGoals();
    }
}

public class CreeperEntity extends MonsterEntity {
    public CreeperEntity(double x, double y, double z) {
        super(x, y, z, MOB_CREEPER);
        registerGoals();
    }

    @Override
    public func void registerGoals() {
        goalSelector.addGoal(0, new FloatGoal(this));
        goalSelector.addGoal(1, new TargetPlayerGoal(this, 16.0));
        goalSelector.addGoal(2, new CreeperIgniteGoal(this, 2.5));
        goalSelector.addGoal(3, new MeleeAttackGoal(this, 0.048, 2.0));
        goalSelector.addGoal(4, new RandomStrollGoal(this, 0.022));
        goalSelector.addGoal(5, new LookAtPlayerGoal(this, 8.0));
    }
}

public class PlayerEntity extends Mob {
    public PlayerEntity(double x, double y, double z) {
        super(x, y, z, MOB_PLAYER);
    }
}
