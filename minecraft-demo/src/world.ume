// ═══════════════════════════════════════════════════════════════════════════
// world.ume — Chunk, World, Camera, save/load
// ═══════════════════════════════════════════════════════════════════════════
//
// Chunk: 16×16×8 voxel slab. Builds a textured mesh (stride=8).
// World: list of chunks + mob list + chunk-streaming + mob spawning.
// Camera: position + yaw/pitch, exposes fwdX/Y/Z and VP matrix.
//
// Save format (backward-compatible):
//   VERSION: 2
//   PLAYER: x,y,z,yaw,pitch,health
//   TIME: <worldTime>
//   HOTBAR: 9 ints (blockIds, count defaults to 1 if old save)
//   INV: 27 ints (blockIds, optional — old saves omit)
//   EXPLOSIONS: (none persisted — only in-session)

import std.random.*;
import std.math.*;
import std.thread.*;

// ── Chunk ───────────────────────────────────────────────────────────────────
public class Chunk {
    public int   chunkX;
    public int   chunkZ;
    public int[] blocks;
    public Mesh  mesh;
    public int   faceCount;
    public bool  isBuilt;
    public bool  dirty;
    public bool  generated;
    public bool  generating;

    public Chunk(int cx, int cz) {
        chunkX = cx; chunkZ = cz;
        blocks = new int[16 * 16 * 8];
        isBuilt = false; dirty = false; generated = false; generating = false; faceCount = 0;
    }

    public func void generate() {
        int wx0 = chunkX * 16; int wz0 = chunkZ * 16;
        for (int lx = 0; lx < 16; lx++) {
            for (int lz = 0; lz < 16; lz++) {
                int sh = worldSurfaceAt(wx0 + lx, wz0 + lz);
                for (int y = 0; y < 8; y++) {
                    int t = 0;
                    if      (y == 0)   t = BLOCK_BEDROCK;
                    else if (y < sh-2) t = BLOCK_STONE;
                    else if (y < sh-1) {
                        // Rare ore pockets
                        if ((lx + lz + y + chunkX * 7 + chunkZ * 3) % 23 == 0)      t = BLOCK_COAL_ORE;
                        else if ((lx * 3 + lz * 7 + y * 5 + chunkX) % 41 == 0)      t = BLOCK_IRON_ORE;
                        else if ((lx * 5 + lz * 11 + y * 3 + chunkZ * 2) % 97 == 0) t = BLOCK_DIAMOND_ORE;
                        else if ((lx * 7 + lz * 3 + y * 2 + chunkX * 5) % 71 == 0)   t = BLOCK_GOLD_ORE;
                        else t = BLOCK_STONE;
                    }
                    else if (y < sh)   t = BLOCK_DIRT;
                    else if (y == sh)  {
                        if (sh <= 2) t = BLOCK_SAND;
                        else t = BLOCK_GRASS;
                    }
                    blocks[lx + lz*16 + y*256] = t;
                }
            }
        }
        // Trees
        var rng = new Random(7919 + chunkX * 7321 + chunkZ * 3739);
        int numTrees = rng.nextInt(3) + 1;
        for (int t = 0; t < numTrees; t++) {
            int tx = rng.nextInt(11) + 2; int tz2 = rng.nextInt(11) + 2;
            int sh = worldSurfaceAt(wx0 + tx, wz0 + tz2);
            if (blocks[tx + tz2*16 + sh*256] == BLOCK_GRASS && sh + 4 < 8) {
                // Trunk (3 tall)
                blocks[tx + tz2*16 + (sh+1)*256] = BLOCK_LOG;
                blocks[tx + tz2*16 + (sh+2)*256] = BLOCK_LOG;
                blocks[tx + tz2*16 + (sh+3)*256] = BLOCK_LOG;
                // Leaves (3x3 canopy at trunk top, 1x1 cap)
                int top = sh + 3;
                for (int dx = -2; dx <= 2; dx++) {
                    for (int dz2 = -2; dz2 <= 2; dz2++) {
                        if (dx == 0 && dz2 == 0) continue;
                        int lx2 = tx + dx; int lz3 = tz2 + dz2;
                        if (lx2 >= 0 && lx2 < 16 && lz3 >= 0 && lz3 < 16) {
                            if (top < 8 && blocks[lx2 + lz3*16 + top*256] == 0)
                                blocks[lx2 + lz3*16 + top*256] = BLOCK_LEAVES;
                            if (top-1 > sh && top-1 < 8 && blocks[lx2 + lz3*16 + (top-1)*256] == 0)
                                blocks[lx2 + lz3*16 + (top-1)*256] = BLOCK_LEAVES;
                        }
                    }
                }
                // Cap
                if (top+1 < 8) blocks[tx + tz2*16 + (top+1)*256] = BLOCK_LEAVES;
            }
        }
        // Flowers
        int numFlowers = rng.nextInt(5);
        for (int f = 0; f < numFlowers; f++) {
            int fx2 = rng.nextInt(14) + 1; int fz2 = rng.nextInt(14) + 1;
            int sh = worldSurfaceAt(wx0 + fx2, wz0 + fz2);
            if (sh < 7 && blocks[fx2 + fz2*16 + sh*256] == BLOCK_GRASS && blocks[fx2 + fz2*16 + (sh+1)*256] == 0) {
                blocks[fx2 + fz2*16 + (sh+1)*256] = BLOCK_FLOWER;
            }
        }
    }
}

// ── World ───────────────────────────────────────────────────────────────────
public class World {
    public Chunk[] chunks;
    public int[]   cgx;
    public int[]   cgz;
    public int     count;
    public int     cap;
    public Map<long, int> chunkMap;
    public Mutex mutex;
    public Thread genThread;
    public Random rng2;
    public float[] meshVerts;
    public int[]   meshInds;
    public Mob[]   mobs;
    public int     mobCount;
    public int     mobCap;
    public int[]   pendingDrops;  // blockId queue for items to drop (one-shot)
    public int     pendingDropCount;

    public World(int capacity) {
        cap = capacity; count = 0;
        chunks = new Chunk[capacity]; cgx = new int[capacity]; cgz = new int[capacity];
        chunkMap = new Map<long, int>();
        mutex = new Mutex();
        // Reduce initial allocation sizes
        meshVerts = new float[98304];  // 1/4 original size
        meshInds  = new int[18432];    // 1/4 original size
        rng2 = new Random(System.currentTimeMillis());
        genThread = new Thread(() -> { this.runGenThread(); });
        genThread.start();
        mobs = new Mob[40];
        mobCount = 0;
        mobCap = 40;
        pendingDrops = new int[64];
        pendingDropCount = 0;
    }

    private func long chunkKey(int cx, int cz) { return (cast<long>(cx) << 32) | (cast<long>(cz) & 0xFFFFFFFF); }
    public func int findChunk(int cx, int cz) { for (int i = 0; i < count; i++) { if (cgx[i] == cx && cgz[i] == cz) return i; } return -1; }
    private func int floorDiv(int a, int b) { int q = a / b; if ((a ^ b) < 0 && q * b != a) q--; return q; }

    public func int getWorldBlock(int wx, int wy, int wz) {
        if (wy < 0 || wy >= 8) return 0;
        int cx = floorDiv(wx, 16); int cz = floorDiv(wz, 16);
        int i = findChunk(cx, cz);
        if (i < 0 || !chunks[i].generated) return 0;
        int lx = wx - cx*16; int lz = wz - cz*16;
        int b = chunks[i].blocks[lx + lz*16 + wy*256];
        return (b < 0 ? 0 : b);
    }

    public func void setWorldBlock(int wx, int wy, int wz, int type) {
        if (wy < 0 || wy >= 8) return;
        int cx = floorDiv(wx, 16); int cz = floorDiv(wz, 16);
        int i = findChunk(cx, cz);
        if (i < 0 || !chunks[i].generated) return;
        int lx = wx - cx*16; int lz = wz - cz*16;
        chunks[i].blocks[lx + lz*16 + wy*256] = type;
        chunks[i].dirty = true;
        if (lx == 0)  markDirty(cx-1, cz);
        if (lx == 15) markDirty(cx+1, cz);
        if (lz == 0)  markDirty(cx, cz-1);
        if (lz == 15) markDirty(cx, cz+1);
    }

    private func void markDirty(int cx, int cz) {
        int i = findChunk(cx, cz);
        if (i >= 0 && chunks[i].generated) chunks[i].dirty = true;
    }

    public func void loadChunkImmediate(int cx, int cz) {
        if (findChunk(cx, cz) >= 0 || count >= cap) return;
        Chunk c = new Chunk(cx, cz);
        chunks[count] = c; cgx[count] = cx; cgz[count] = cz;
        count++;
        c.generate(); c.generated = true; c.dirty = true;
        spawnMobsForChunk(cx, cz);
    }

    public func void loadChunkAsync(int cx, int cz) {
        // Add memory safety check
        if (findChunk(cx, cz) >= 0 || count >= cap || cap <= 0) return;
        if (count >= chunks.length) return;
        
        Chunk c = new Chunk(cx, cz);
        chunks[count] = c; 
        cgx[count] = cx; 
        cgz[count] = cz;
        count++; 
        c.generating = true;
    }

    public func void loadNearestMissing(int pcx, int pcz, int renderR) {
        int bestDist = 99999; int bestX = 0; int bestZ = 0; bool found = false;
        for (int dx = -renderR; dx <= renderR; dx++) {
            for (int dz = -renderR; dz <= renderR; dz++) {
                int ax = (dx < 0 ? -dx : dx); int az = (dz < 0 ? -dz : dz);
                int dist = ax + az;
                if (dist > renderR + 1) continue;
                int tcx = pcx + dx; int tcz = pcz + dz;
                if (findChunk(tcx, tcz) < 0 && count < cap) {
                    if (dist < bestDist) { bestDist = dist; bestX = tcx; bestZ = tcz; found = true; }
                }
            }
        }
        if (found) { loadChunkAsync(bestX, bestZ); }
    }

    // ── Mob spawning — passive mobs during day, hostile at night ────────────
    public func void spawnMobsForChunk(int cx, int cz) {
        if (mobCount >= mobCap) return;
        var rng = new Random(cx * 31 + cz * 17 + 999);
        int numMobs = rng.nextInt(3);
        for (int m = 0; m < numMobs && mobCount < mobCap; m++) {
            int mx = cx * 16 + rng.nextInt(14) + 1;
            int mz = cz * 16 + rng.nextInt(14) + 1;
            int my = worldSurfaceAt(mx, mz) + 1;
            // Pick a random passive mob
            int r = rng.nextInt(4);
            int type = (r == 0) ? MOB_PIG : (r == 1) ? MOB_COW : (r == 2) ? MOB_SHEEP : MOB_CHICKEN;
            mobs[mobCount] = new Mob(cast<double>(mx), cast<double>(my), cast<double>(mz), type);
            mobCount++;
        }
    }

    public func void spawnHostileMob(int cx, int cz, bool isNight) {
        if (mobCount >= mobCap || !isNight) return;
        var rng = new Random(cx * 13 + cz * 41 + cast<int>(System.currentTimeMillis() % 1000000));
        int mx = cx * 16 + rng.nextInt(14) + 1;
        int mz = cz * 16 + rng.nextInt(14) + 1;
        int my = worldSurfaceAt(mx, mz) + 1;
        int r = rng.nextInt(4);
        int type = (r == 0) ? MOB_ZOMBIE : (r == 1) ? MOB_SKELETON : (r == 2) ? MOB_SPIDER : MOB_CREEPER;
        mobs[mobCount] = new Mob(cast<double>(mx), cast<double>(my), cast<double>(mz), type);
        mobCount++;
    }

    public func void updateMobs(double dt, double px, double py, double pz, bool isNight) {
        for (int i = 0; i < mobCount; i++) {
            if (mobs[i].alive) {
                int bx = cast<int>(Math.floor(mobs[i].x));
                int by = cast<int>(Math.floor(mobs[i].y));
                int bz = cast<int>(Math.floor(mobs[i].z));
                mobs[i].update(dt, px, py, pz, isNight, getWorldBlock(bx, by - 1, bz));

                // Creeper explosion (no cast needed — `exploded` is a base-Mob field)
                if (mobs[i].exploded) {
                    explode(cast<int>(Math.floor(mobs[i].x)),
                            cast<int>(Math.floor(mobs[i].y)),
                            cast<int>(Math.floor(mobs[i].z)), 3);
                    mobs[i].exploded = false;  // consume the flag
                }

                double dx2 = mobs[i].x - px; double dz2 = mobs[i].z - pz;
                if (dx2*dx2 + dz2*dz2 > 1600.0) mobs[i].alive = false;

                // Drop on death
                if (!mobs[i].alive) {
                    MobDef def = Mobs.get(mobs[i].mobType);
                    if (def != null && def.dropBlockId != 0 && pendingDropCount < 60) {
                        pendingDrops[pendingDropCount] = def.dropBlockId;
                        pendingDropCount++;
                        if (def.dropCount > 1) {
                            for (int k = 1; k < def.dropCount && pendingDropCount < 60; k++) {
                                pendingDrops[pendingDropCount] = def.dropBlockId;
                                pendingDropCount++;
                            }
                        }
                    }
                }
            }
        }
        // Compact alive mobs
        int w = 0;
        for (int i = 0; i < mobCount; i++) { if (mobs[i] != null && mobs[i].alive) { mobs[w] = mobs[i]; w++; } }
        mobCount = w;

        // Spawn hostiles at night
        if (isNight && mobCount < mobCap && rng2.nextDouble() < 0.012) {
            int pcx = cast<int>(Math.floor(px / 16.0));
            int pcz = cast<int>(Math.floor(pz / 16.0));
            spawnHostileMob(pcx + cast<int>(Math.floor(rng2.nextDouble() * 6) - 3),
                            pcz + cast<int>(Math.floor(rng2.nextDouble() * 6) - 3), true);
        }
    }

    // ── Explosion: destroy blocks in radius ─────────────────────────────────
    public func void explode(int cx, int cy, int cz, int radius) {
        for (int dx = -radius; dx <= radius; dx++) {
            for (int dy = -radius; dy <= radius; dy++) {
                for (int dz = -radius; dz <= radius; dz++) {
                    double dd = Math.sqrt(cast<double>(dx*dx + dy*dy + dz*dz));
                    if (dd <= cast<double>(radius)) {
                        int b = getWorldBlock(cx+dx, cy+dy, cz+dz);
                        if (b != 0 && b != BLOCK_BEDROCK) {
                            setWorldBlock(cx+dx, cy+dy, cz+dz, 0);
                        }
                    }
                }
            }
        }
    }

    // ── Drain pending drops into inventory (called from main loop) ──────────
    public func int takePendingDrop(int idx) {
        if (idx < 0 || idx >= pendingDropCount) return 0;
        return pendingDrops[idx];
    }

    public func void clearPendingDrops() { pendingDropCount = 0; }

    public func void runGenThread() {
        while (count < cap) {  // Add safety limit
            Chunk target = null;
            mutex.lock();
            for (int i = 0; i < count; i++) { 
                if (chunks[i].generating) { 
                    target = chunks[i]; 
                    break; 
                } 
            }
            mutex.unlock();
            if (target != null) { 
                target.generate(); 
                target.generated = true; 
                target.generating = false; 
                target.dirty = true; 
            } else { 
                Thread.sleep(20);  // Reduce CPU usage
            }
        }
    }

    public func void evictFar(int pcx, int pcz, int renderR) {
        int limit = renderR + 2;
        for (int i = 0; i < count; i++) {
            int dx = cgx[i] - pcx; int dz = cgz[i] - pcz;
            if (dx < 0) dx = -dx; if (dz < 0) dz = -dz;
            if (dx > limit || dz > limit) {
                chunkMap.remove(chunkKey(cgx[i], cgz[i]));
                int last = count - 1;
                if (i != last) {
                    chunks[i] = chunks[last]; cgx[i] = cgx[last]; cgz[i] = cgz[last];
                    chunkMap.put(chunkKey(cgx[i], cgz[i]), i);
                }
                count--; i--;
            }
        }
    }

    // ── buildMesh: stride=8 format [x,y,z, ao,0,0, u,v] ──────────────────────
    public func void buildMesh(int i) {
        Chunk c = chunks[i];
        if (!c.generated) return;
        int[] blk = c.blocks;
        int wx0 = cgx[i] * 16; int wz0 = cgz[i] * 16;
        int[] blk_nx = null; int[] blk_px = null; int[] blk_nz = null; int[] blk_pz = null;
        int idx = findChunk(cgx[i]-1, cgz[i]); if (idx >= 0 && chunks[idx].generated) blk_nx = chunks[idx].blocks;
        idx = findChunk(cgx[i]+1, cgz[i]); if (idx >= 0 && chunks[idx].generated) blk_px = chunks[idx].blocks;
        idx = findChunk(cgx[i], cgz[i]-1); if (idx >= 0 && chunks[idx].generated) blk_nz = chunks[idx].blocks;
        idx = findChunk(cgx[i], cgz[i]+1); if (idx >= 0 && chunks[idx].generated) blk_pz = chunks[idx].blocks;
        float[] verts = meshVerts; int[] inds = meshInds;
        int vi = 0; int ii = 0; int vc = 0;
        float fwx = cast<float>(wx0); float fwz = cast<float>(wz0);

        for (int x = 0; x < 16; x++) {
            for (int y = 0; y < 8; y++) {
                for (int z = 0; z < 16; z++) {
                    int bt = blk[x + z*16 + y*256];
                    if (bt <= 0) continue;
                    float fx = fwx + cast<float>(x); float fy = cast<float>(y); float fz2 = fwz + cast<float>(z);
                    float fx1 = fx+1.0; float fy1 = fy+1.0; float fz3 = fz2+1.0;
                    int nb = 0;
                    BlockDef def = Blocks.get(bt);
                    bool transparent = (def != null && def.isTransparent());
                    bool cross = (def != null && def.isCross());

                    // ── Top face ───────────────────────────────────────────────────
                    if (y < 7) { nb = blk[x + z*16 + (y+1)*256]; } else { nb = 0; }
                    if (nb==0||nb==BLOCK_LEAVES||nb==BLOCK_FLOWER||bt==BLOCK_WATER) {
                        float[] uv = Blocks.faceUV(bt, 0); float ao = Blocks.faceAO(0);
                        float u0=uv[0]; float v0=uv[1]; float u1=uv[2]; float v1=uv[3];
                        verts[vi]=fx;  verts[vi+1]=fy1; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy1; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy1; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy1; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v0; vi+=8;
                        inds[ii]=vc;inds[ii+1]=vc+1;inds[ii+2]=vc+2;inds[ii+3]=vc+2;inds[ii+4]=vc+3;inds[ii+5]=vc; ii+=6;vc+=4;
                    }
                    // ── Bottom face ────────────────────────────────────────────
                    if (y > 0) { nb = blk[x + z*16 + (y-1)*256]; } else { nb = 0; }
                    if (nb==0||nb==BLOCK_LEAVES||nb==BLOCK_FLOWER||bt==BLOCK_WATER) {
                        float[] uv = Blocks.faceUV(bt, 1); float ao = Blocks.faceAO(1);
                        float u0=uv[0]; float v0=uv[1]; float u1=uv[2]; float v1=uv[3];
                        verts[vi]=fx;  verts[vi+1]=fy; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v1; vi+=8;
                        inds[ii]=vc;inds[ii+1]=vc+1;inds[ii+2]=vc+2;inds[ii+3]=vc+2;inds[ii+4]=vc+3;inds[ii+5]=vc; ii+=6;vc+=4;
                    }
                    // ── +X face ──────────────────────────────────────────────────
                    if (x < 15) { nb = blk[(x+1)+z*16+y*256]; } else { nb = (blk_px!=null ? blk_px[0+z*16+y*256] : 0); }
                    if (nb==0||nb==BLOCK_LEAVES||nb==BLOCK_FLOWER||bt==BLOCK_WATER) {
                        float[] uv = Blocks.faceUV(bt, 2); float ao = Blocks.faceAO(2);
                        float u0=uv[0]; float v0=uv[1]; float u1=uv[2]; float v1=uv[3];
                        verts[vi]=fx1; verts[vi+1]=fy;  verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy;  verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy1; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy1; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v1; vi+=8;
                        inds[ii]=vc;inds[ii+1]=vc+1;inds[ii+2]=vc+2;inds[ii+3]=vc+2;inds[ii+4]=vc+3;inds[ii+5]=vc; ii+=6;vc+=4;
                    }
                    // ── -X face ──────────────────────────────────────────────────
                    if (x > 0) { nb = blk[(x-1)+z*16+y*256]; } else { nb = (blk_nx!=null ? blk_nx[15+z*16+y*256] : 0); }
                    if (nb==0||nb==BLOCK_LEAVES||nb==BLOCK_FLOWER||bt==BLOCK_WATER) {
                        float[] uv = Blocks.faceUV(bt, 3); float ao = Blocks.faceAO(3);
                        float u0=uv[0]; float v0=uv[1]; float u1=uv[2]; float v1=uv[3];
                        verts[vi]=fx;  verts[vi+1]=fy;  verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy;  verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy1; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy1; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v1; vi+=8;
                        inds[ii]=vc;inds[ii+1]=vc+1;inds[ii+2]=vc+2;inds[ii+3]=vc+2;inds[ii+4]=vc+3;inds[ii+5]=vc; ii+=6;vc+=4;
                    }
                    // ── +Z face ──────────────────────────────────────────────────
                    if (z < 15) { nb = blk[x+(z+1)*16+y*256]; } else { nb = (blk_pz!=null ? blk_pz[x+0*16+y*256] : 0); }
                    if (nb==0||nb==BLOCK_LEAVES||nb==BLOCK_FLOWER||bt==BLOCK_WATER) {
                        float[] uv = Blocks.faceUV(bt, 4); float ao = Blocks.faceAO(4);
                        float u0=uv[0]; float v0=uv[1]; float u1=uv[2]; float v1=uv[3];
                        verts[vi]=fx;  verts[vi+1]=fy;  verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy;  verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy1; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy1; verts[vi+2]=fz3; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v1; vi+=8;
                        inds[ii]=vc;inds[ii+1]=vc+1;inds[ii+2]=vc+2;inds[ii+3]=vc+2;inds[ii+4]=vc+3;inds[ii+5]=vc; ii+=6;vc+=4;
                    }
                    // ── -Z face ──────────────────────────────────────────────────
                    if (z > 0) { nb = blk[x+(z-1)*16+y*256]; } else { nb = (blk_nz!=null ? blk_nz[x+15*16+y*256] : 0); }
                    if (nb==0||nb==BLOCK_LEAVES||nb==BLOCK_FLOWER||bt==BLOCK_WATER) {
                        float[] uv = Blocks.faceUV(bt, 5); float ao = Blocks.faceAO(5);
                        float u0=uv[0]; float v0=uv[1]; float u1=uv[2]; float v1=uv[3];
                        verts[vi]=fx1; verts[vi+1]=fy;  verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy;  verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v0; vi+=8;
                        verts[vi]=fx;  verts[vi+1]=fy1; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u1; verts[vi+7]=v1; vi+=8;
                        verts[vi]=fx1; verts[vi+1]=fy1; verts[vi+2]=fz2; verts[vi+3]=ao; verts[vi+4]=0; verts[vi+5]=0; verts[vi+6]=u0; verts[vi+7]=v1; vi+=8;
                        inds[ii]=vc;inds[ii+1]=vc+1;inds[ii+2]=vc+2;inds[ii+3]=vc+2;inds[ii+4]=vc+3;inds[ii+5]=vc; ii+=6;vc+=4;
                    }
                }
            }
        }
        c.faceCount = vc / 4;
        if (c.faceCount == 0) {
            if (c.mesh != null) c.mesh.updateData(verts, inds, 0, 0);
            c.isBuilt = true; c.dirty = false; return;
        }
        if (c.mesh == null) { c.mesh = Mesh.Create(verts, inds, 8); }
        else { c.mesh.updateData(verts, inds, vi, ii); }
        c.isBuilt = true; c.dirty = false;
    }

    public func void rebuildDirtyChunks(int maxPerFrame) {
        int rebuilt = 0;
        for (int i = 0; i < count; i++) {
            if (chunks[i].dirty && chunks[i].generated) {
                buildMesh(i); rebuilt++;
                if (rebuilt >= maxPerFrame) return;
            }
        }
    }
}

// ── Camera ──────────────────────────────────────────────────────────────────
public class Camera {
    public double x; public double y; public double z;
    public double yaw; public double pitch;
    public Camera(double x, double y, double z) { this.x = x; this.y = y; this.z = z; yaw = 0.0; pitch = 0.0; }
    public func double fwdX() { return -Math.sin(yaw) * Math.cos(pitch); }
    public func double fwdY() { return  Math.sin(pitch); }
    public func double fwdZ() { return -Math.cos(yaw)  * Math.cos(pitch); }
    public func Matrix4x4 getVP(float aspect) {
        Matrix4x4 view = Matrix4x4.lookAt(x, y, z, x+fwdX(), y+fwdY(), z+fwdZ(), 0.0, 1.0, 0.0);
        Matrix4x4 proj = Matrix4x4.perspective(1.15, aspect, 0.05, 200.0);
        return proj * view;
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Save / Load (backward compatible v2)
// ═══════════════════════════════════════════════════════════════════════════
public int SAVE_VERSION = 2;

public func void saveGame(int slot, double px, double py, double pz, double yaw, double pitch,
                          int health, ItemStack[] hotbar, ItemStack[] inv, double worldTime) {
    string filename = "umecraft_world_" + slot + ".txt";
    string data = "VERSION:" + SAVE_VERSION + "\n";
    data = data + "PLAYER:" + px + "," + py + "," + pz + "," + yaw + "," + pitch + "," + health + "\n";
    data = data + "TIME:" + worldTime + "\n";
    // Hotbar: 9 slots, each "id,count"
    data = data + "HOTBAR:";
    int hbLen = hotbar.length();
    for (int i = 0; i < 9; i++) {
        if (i > 0) data = data + ";";
        if (i < hbLen) {
            data = data + hotbar[i].blockId + "," + hotbar[i].count;
        } else {
            data = data + "0,0";
        }
    }
    data = data + "\n";
    // Inventory: 27 slots
    data = data + "INV:";
    int invLen = (inv == null) ? 0 : inv.length();
    for (int i = 0; i < 27; i++) {
        if (i > 0) data = data + ";";
        if (i < invLen) {
            data = data + inv[i].blockId + "," + inv[i].count;
        } else {
            data = data + "0,0";
        }
    }
    data = data + "\n";
    FileSystem.writeText(filename, data);
}

// Backward-compatible loader. Reads v1 (old int[] hotbar) and v2 (stacks).
//   outData[0..5] = px,py,pz,yaw,pitch,health
//   outTime[0]    = worldTime
//   outHotbar     = ItemStack[9] (caller must pre-allocate)
//   outInv        = ItemStack[27] (caller must pre-allocate)
public func bool loadGame(int slot, float[] outData, ItemStack[] outHotbar, ItemStack[] outInv, float[] outTime) {
    string filename = "umecraft_world_" + slot + ".txt";
    string content = FileSystem.readText(filename);
    if (content.length() == 0) return false;
    string[] lines = content.split("\n");
    int version = 1;
    for (int i = 0; i < lines.length(); i++) {
        string line = lines[i];
        if (line.startsWith("VERSION:")) {
            version = line.substring(8, line.length()).trim().toInt();
        }
        else if (line.startsWith("PLAYER:")) {
            string rest = line.substring(7, line.length());
            string[] parts = rest.split(",");
            if (parts.length() >= 6) {
                outData[0] = cast<float>(parts[0].toDouble());
                outData[1] = cast<float>(parts[1].toDouble());
                outData[2] = cast<float>(parts[2].toDouble());
                outData[3] = cast<float>(parts[3].toDouble());
                outData[4] = cast<float>(parts[4].toDouble());
                outData[5] = cast<float>(parts[5].toDouble());
            }
        }
        else if (line.startsWith("TIME:")) {
            outTime[0] = cast<float>(line.substring(5, line.length()).trim().toDouble());
        }
        else if (line.startsWith("HOTBAR:")) {
            string rest = line.substring(7, line.length());
            if (version >= 2) {
                // "id,count;id,count;..."
                string[] slots = rest.split(";");
                for (int j = 0; j < 9 && j < slots.length(); j++) {
                    string[] pair = slots[j].split(",");
                    if (pair.length() >= 2) {
                        outHotbar[j].blockId = pair[0].trim().toInt();
                        outHotbar[j].count    = pair[1].trim().toInt();
                    } else {
                        outHotbar[j].setEmpty();
                    }
                }
            } else {
                // v1: comma-separated ints
                string[] ids = rest.split(",");
                for (int j = 0; j < 9 && j < ids.length(); j++) {
                    int id = ids[j].trim().toInt();
                    if (id != 0) { outHotbar[j].blockId = id; outHotbar[j].count = 1; }
                    else { outHotbar[j].setEmpty(); }
                }
            }
        }
        else if (line.startsWith("INV:") && version >= 2) {
            string rest = line.substring(4, line.length());
            string[] slots = rest.split(";");
            for (int j = 0; j < 27 && j < slots.length(); j++) {
                string[] pair = slots[j].split(",");
                if (pair.length() >= 2) {
                    outInv[j].blockId = pair[0].trim().toInt();
                    outInv[j].count    = pair[1].trim().toInt();
                } else {
                    outInv[j].setEmpty();
                }
            }
        }
    }
    return true;
}

public func bool worldExists(int slot) {
    string filename = "umecraft_world_" + slot + ".txt";
    string content = FileSystem.readText(filename);
    return content.length() > 0;
}
