// ═══════════════════════════════════════════════════════════════════════════
// Main.ume — UmeCraft 3D — Enhanced Edition v6.0 Entry Point
// ═══════════════════════════════════════════════════════════════════════════
//
// ┌─────────────────────────────────────────────────────────────────────────┐
// │                         KEY BINDINGS                                    │
// ├─────────────────────────────────────────────────────────────────────────┤
// │  W / A / S / D    — Move forward / left / back / right                  │
// │  Space            — Jump                                                │
// │  Left Shift       — Sprint (ground) / Descend (fly)                     │
// │  Left Control     — Sprint                                              │
// │  F                — Toggle fly mode (creative)                          │
// │  Tab              — Toggle mouse grab (pointer lock)                    │
// │  E                — Open / close survival inventory                     │
// │  Escape           — Game menu / release mouse                           │
// │  F3               — Toggle debug overlay                                │
// │  F5               — Save world                                          │
// │  F9               — Load world                                          │
// │  R                — Respawn (if dead)                                   │
// │  1 – 9            — Select hotbar slot 1–9                              │
// │  Mouse Move       — Look around (when grabbed)                          │
// │  Mouse Left       — Break block / Attack mob                            │
// │  Mouse Right      — Place block                                         │
// └─────────────────────────────────────────────────────────────────────────┘

import std.graphics.*;
import std.math.*;
import std.matrix.*;
import std.collections.*;
import std.time.*;
import std.thread.*;

// ── JSON ─────────────────────────────────────────────────────────────────────
#include "json/JsonValue.ume"
#include "json/JsonParser.ume"

// ── Blocks ───────────────────────────────────────────────────────────────────
#include "block/BlockIds.ume"
#include "block/BlockDef.ume"
#include "block/Blocks.ume"

// ── Items ────────────────────────────────────────────────────────────────────
#include "item/ItemStack.ume"
#include "item/Items.ume"

// ── Models ───────────────────────────────────────────────────────────────────
#include "model/MobPart.ume"
#include "model/GeoModelLoader.ume"
#include "model/MobFallbacks.ume"
#include "model/MobModels.ume"

// ── Entities ─────────────────────────────────────────────────────────────────
#include "entity/EntityBase.ume"
#include "entity/ai/IGoal.ume"
#include "entity/Mob.ume"
#include "entity/ai/PassiveGoals.ume"
#include "entity/ai/CombatGoals.ume"
#include "entity/mobs/PassiveMobs.ume"
#include "entity/mobs/HostileMobs.ume"
#include "entity/Entities.ume"
#include "entity/MobDef.ume"
#include "entity/MobRegistry.ume"

// ── World ────────────────────────────────────────────────────────────────────
#include "world/ChunkConstants.ume"
#include "world/WorldGen.ume"
#include "world/Chunk.ume"
#include "world/Camera.ume"
#include "world/WorldSave.ume"
#include "world/World.ume"

// ── Renderer ─────────────────────────────────────────────────────────────────
#include "render/ShaderManager.ume"
#include "render/TextureAtlas.ume"
#include "render/WorldRenderer.ume"

// ── UI ───────────────────────────────────────────────────────────────────────
#include "ui/Widget.ume"
#include "ui/HUD.ume"
#include "ui/InventoryScreen.ume"
#include "ui/MenuScreen.ume"

// ── Game systems ─────────────────────────────────────────────────────────────
#include "game/GameState.ume"
#include "player/Player.ume"

// ═══════════════════════════════════════════════════════════════════════════
// MAIN — Setup & orchestration only. All heavy logic lives in the modules above.
// ═══════════════════════════════════════════════════════════════════════════
func void main() {
    // ── Window & shaders ──────────────────────────────────────────────────────
    Window win = new Window(1024, 720, "UmeCraft 3D — v6.0 Enhanced");
    win.enableDepthTest(true);
    win.enableCullFace(true);
    win.setCursorGrabbed(false);
    Font font = Font.createDefault(18.0);

    Shader terrainSh   = buildTerrainShader();
    Shader hudSh       = buildHUDShader();
    Shader mobSh       = buildMobShader();
    Shader celestialSh = buildCelestialShader();
    Mesh   quad        = Mesh.Quad();

    // ── Texture atlas ─────────────────────────────────────────────────────────
    Texture atlas = loadTextureAtlas("assets/textures/");

    // ── Game state ────────────────────────────────────────────────────────────
    GameState gs = new GameState();
    gs.py       = 70.0;
    gs.lastTime = Time.seconds();
    Camera cam  = new Camera(gs.px, gs.py + 1.62, gs.pz);

    // ── Hotbar & inventory ────────────────────────────────────────────────────
    ItemStack[] hotbar = newStacks(9);
    hotbar[0].set(BLOCK_GRASS, 64);  
    hotbar[1].set(BLOCK_DIRT,   64);
    hotbar[2].set(BLOCK_STONE, 64);  
    hotbar[3].set(BLOCK_COBBLE, 64);
    hotbar[4].set(BLOCK_PLANKS, 64); 
    hotbar[5].set(BLOCK_LOG,    64);
    hotbar[6].set(BLOCK_SAND,  64);  
    hotbar[7].set(BLOCK_GLASS,  32);
    hotbar[8].set(BLOCK_BRICK, 32);

    ItemStack[] inventory = newStacks(27);
    inventory[0].set(BLOCK_LEAVES,   32);
    inventory[1].set(BLOCK_SNOW,     16);
    inventory[2].set(BLOCK_COAL_ORE,  8);
    inventory[3].set(BLOCK_IRON_ORE,  4);

    InventoryScreen invScreen = new InventoryScreen();

    // ── World ─────────────────────────────────────────────────────────────────
    World world = new World(6000);

    // ── UI elements ───────────────────────────────────────────────────────────
    Button btnSingleplayer = new Button("Singleplayer", 0, 0, 380, 42);
    Button btnOptionsMain  = new Button("Options...",   0, 0, 184, 42);
    Button btnQuitMain     = new Button("Quit Game",    0, 0, 184, 42);
    btnSingleplayer.setColor(0.28, 0.28, 0.32); btnSingleplayer.setHoverColor(0.38, 0.52, 0.38);
    btnOptionsMain.setColor(0.28, 0.28, 0.32);  btnOptionsMain.setHoverColor(0.40, 0.40, 0.46);
    btnQuitMain.setColor(0.45, 0.15, 0.15);     btnQuitMain.setHoverColor(0.65, 0.22, 0.22);

    Button btnPlayWorld    = new Button("Play Selected World", 0, 0, 160, 38);
    Button btnCreateSelect = new Button("Create New World",    0, 0, 160, 38);
    Button btnDeleteWorld  = new Button("Delete",              0, 0, 90,  38);
    Button btnCancelSelect = new Button("Cancel",              0, 0, 90,  38);
    btnPlayWorld.setColor(0.20, 0.42, 0.20);    btnPlayWorld.setHoverColor(0.30, 0.60, 0.30);
    btnCreateSelect.setColor(0.28, 0.28, 0.32); btnCreateSelect.setHoverColor(0.40, 0.40, 0.46);
    btnDeleteWorld.setColor(0.42, 0.15, 0.15);  btnDeleteWorld.setHoverColor(0.60, 0.22, 0.22);
    btnCancelSelect.setColor(0.28, 0.28, 0.32); btnCancelSelect.setHoverColor(0.40, 0.40, 0.46);

    TextInput inputWorldName   = new TextInput("New World", 0, 0, 400, 36, "World Name");
    Button    btnGameMode      = new Button("Game Mode: Survival", 0, 0, 400, 36);
    TextInput inputSeed        = new TextInput("", 0, 0, 400, 36, "Leave blank for random seed");
    Button    btnConfirmCreate = new Button("Create New World", 0, 0, 190, 40);
    Button    btnCancelCreate  = new Button("Cancel",           0, 0, 190, 40);
    string    createGameMode   = "Survival";
    btnGameMode.setColor(0.28, 0.28, 0.32);      btnGameMode.setHoverColor(0.40, 0.40, 0.46);
    btnConfirmCreate.setColor(0.20, 0.42, 0.20); btnConfirmCreate.setHoverColor(0.30, 0.60, 0.30);
    btnCancelCreate.setColor(0.28, 0.28, 0.32);  btnCancelCreate.setHoverColor(0.40, 0.40, 0.46);

    List<WorldMeta> cachedWorldList = loadWorldList();
    if (cachedWorldList.size() > 0) {
        gs.selectedWorldId = cachedWorldList.get(0).id;
    }

    Button btnResume   = new Button("Back to Game", 0, 0, 220, 44);
    Button btnSaveQuit = new Button("Save & Quit",  0, 0, 220, 44);
    btnResume.setColor(0.20, 0.42, 0.20);   btnResume.setHoverColor(0.32, 0.60, 0.32);
    btnSaveQuit.setColor(0.45, 0.12, 0.12); btnSaveQuit.setHoverColor(0.65, 0.22, 0.22);

    Button btnRespawn = new Button("Respawn", 0, 0, 240, 42);
    btnRespawn.setColor(0.22, 0.38, 0.22); btnRespawn.setHoverColor(0.32, 0.55, 0.32);

    Slider sliderRD   = new Slider("Render Distance",        0, 0, 600, 2, 32, 8);
    Slider sliderSens = new Slider("Mouse Sensitivity x1000",0, 0, 600, 1,  5, 2);

    bool wasMouseLeftDown = false;
    double timeStep = 1.0 / 60.0;

    // ═══════════════════════════════════════════════════════════════════════════
    // MAIN LOOP
    // ═══════════════════════════════════════════════════════════════════════════
    while (win.isOpen()) {
        win.pollEvents();

        // ── Frame timing ──────────────────────────────────────────────────────
        double currentTime = Time.seconds();
        double frameTime   = currentTime - gs.lastTime;
        gs.lastTime = currentTime;
        if (frameTime > 0.25) frameTime = 0.25;

        gs.fpsTimer += frameTime; gs.fpsCount++;
        if (gs.fpsTimer >= 1.0) {
            gs.currentFPS = gs.fpsCount; gs.fpsCount = 0; gs.fpsTimer = 0.0;
        }
        if (gs.gameState == 1 || gs.gameState == 3 || gs.gameState == 4) {
            gs.worldTime += frameTime / gs.dayLengthSec;
            if (gs.worldTime >= 1.0) gs.worldTime -= 1.0;
        }
        gs.isNight = (gs.worldTime > 0.45 && gs.worldTime < 0.95);
        if (gs.heldItemTimer > 0) gs.heldItemTimer -= frameTime;

        float   sw   = cast<float>(win.getWidth());
        float   sh   = cast<float>(win.getHeight());
        float[] mpos = win.getMousePosition();
        float   mx   = mpos[0]; float my = mpos[1];
        bool mouseLeft  = win.isMouseButtonPressed(MouseButton.Left);
        bool mouseRight = win.isMouseButtonPressed(MouseButton.Right);
        bool mouseLeftClicked = mouseLeft && !wasMouseLeftDown;
        wasMouseLeftDown = mouseLeft;

        // ── Per-frame input (ESC, Tab, mouse look, hotkeys) ───────────────────
        handleInput(gs, win, cam, world, invScreen, hotbar, inventory);

        // ── Fixed-step physics loop ───────────────────────────────────────────
        gs.accumulator += frameTime;
        int maxSteps = 3; int physStep = 0;
        while (gs.accumulator >= timeStep && physStep < maxSteps) {
            gs.tickTimers(timeStep);
            updateHotbar(gs, win);
            updatePhysics(gs, win, cam, world);
            handlePlayerActions(gs, win, cam, world, hotbar, inventory);

            // Chunk boundary — trigger adjacent load + evict distant
            gs.pcx = cast<int>(Math.floor(gs.px / 16.0));
            gs.pcz = cast<int>(Math.floor(gs.pz / 16.0));
            if (gs.pcx != gs.lastPCX || gs.pcz != gs.lastPCZ) {
                gs.lastPCX = gs.pcx; gs.lastPCZ = gs.pcz;
                for (int dx = -1; dx <= 1; dx++) {
                    for (int dz = -1; dz <= 1; dz++) {
                        world.loadChunkImmediate(gs.pcx+dx, gs.pcz+dz);
                    }
                }
                world.evictFar(gs.pcx, gs.pcz, gs.renderR);
            }

            // Mob AI tick
            if (gs.gameState == 1) {
                world.updateMobs(timeStep, gs.px, gs.py, gs.pz, gs.isNight);
            }

            // Drain mob drops into inventory
            if (world.pendingDropCount > 0) {
                for (int di = 0; di < world.pendingDropCount; di++) {
                    addItem(inventory, world.pendingDrops[di], 1);
                }
                world.clearPendingDrops();
            }

            gs.accumulator -= timeStep;
            physStep++;
        }
        if (gs.accumulator >= timeStep) gs.accumulator = 0.0;

        // ── Chunk streaming (background load + mesh rebuild) ──────────────────
        if (gs.gameState == 1) {
            world.loadNearestMissing(gs.pcx, gs.pcz, gs.renderR);
            world.rebuildDirtyChunks(4);
        }

        // ── 3D Rendering ──────────────────────────────────────────────────────
        float[] sky = calcSkyColor(gs.worldTime);
        win.clearRGB(sky[0], sky[1], sky[2]);

        if (gs.gameState != 0 && gs.gameState != 5 && gs.gameState != 6) {
            renderWorld(gs, world, cam, win,
                        terrainSh, mobSh, celestialSh,
                        atlas, quad,
                        sky[0], sky[1], sky[2],
                        cast<float>(currentTime));
        }

        // ── 2D HUD ────────────────────────────────────────────────────────────
        win.enableDepthTest(false);
        hudSh.use();
        hudSh.setInt("uUseTexture", 0);
        hudSh.setFloat("uUVScale",  1.0);
        hudSh.setFloat("uScreenW",  sw);
        hudSh.setFloat("uScreenH",  sh);

        if (gs.gameState == 1 || gs.gameState == 3 || gs.gameState == 4) {
            drawHUD(win, hudSh, quad, sw, sh,
                    hotbar, gs.hotbarSel, gs.health, gs.maxHealth, gs.hunger, gs.maxHunger,
                    gs.grabbed, gs.flying, gs.showDebug,
                    gs.currentFPS, gs.px, gs.py, gs.pz,
                    world.count, world.cap, world.mobCount, gs.worldTime,
                    gs.isNight, hotbar[gs.hotbarSel].blockId, gs.heldItemTimer, world.seed);
        }

        // ── Main menu (Title Screen) ──────────────────────────────────────────
        if (gs.gameState == 0) {
            drawMainMenu(win, hudSh, quad, sw, sh,
                         btnSingleplayer, btnOptionsMain, btnQuitMain,
                         mx, my, mouseLeft);

            if (btnSingleplayer.clicked && gs.setTimer <= 0) {
                cachedWorldList = loadWorldList();
                if (cachedWorldList.size() > 0 && gs.selectedWorldId.length() == 0) {
                    gs.selectedWorldId = cachedWorldList.get(0).id;
                }
                gs.gameState = 5;
                gs.setTimer = 15;
            }
            if (btnOptionsMain.clicked && gs.setTimer <= 0) {
                gs.gameState = 2;
                gs.setTimer = 15;
            }
            if (btnQuitMain.clicked) {
                win.close();
            }
        }

        // ── Select World Screen ───────────────────────────────────────────────
        if (gs.gameState == 5) {
            string clickedCardId = drawSelectWorldMenu(win, hudSh, quad, sw, sh,
                                                       cachedWorldList, gs.selectedWorldId,
                                                       btnPlayWorld, btnCreateSelect, btnDeleteWorld, btnCancelSelect,
                                                       mx, my, mouseLeft, mouseLeftClicked);
            if (clickedCardId.length() > 0) {
                gs.selectedWorldId = clickedCardId;
            }

            if (win.isKeyPressed(Key.Escape) && gs.setTimer <= 0) {
                gs.gameState = 0;
                gs.setTimer = 15;
            }

            // Play Selected World
            if (btnPlayWorld.clicked && gs.selectedWorldId.length() > 0 && gs.setTimer <= 0) {
                float[] ld = new float[6];
                float[] lt = new float[1];
                int[] lseed = new int[1];
                if (loadGameById(gs.selectedWorldId, ld, hotbar, inventory, lt, lseed)) {
                    gs.px = cast<double>(ld[0]);
                    gs.py = cast<double>(ld[1]);
                    gs.pz = cast<double>(ld[2]);
                    cam.yaw   = cast<double>(ld[3]);
                    cam.pitch = cast<double>(ld[4]);
                    gs.health = cast<int>(ld[5]);
                    gs.worldTime = cast<double>(lt[0]);
                    int loadedSeed = lseed[0];
                    if (loadedSeed == 0) loadedSeed = 1337;
                    world.initWorld(loadedSeed, gs.selectedWorldId);
                    world.loadWorldChunksById(gs.selectedWorldId);
                } else {
                    int defaultSeed = 1337;
                    world.initWorld(defaultSeed, gs.selectedWorldId);
                    gs.px = 0.5; gs.pz = 0.5;
                    gs.py = cast<double>(worldSurfaceAt(0, 0, world.worldNoise) + 1);
                    cam.yaw = 0; cam.pitch = 0;
                    gs.worldTime = 0.25;
                    gs.health = gs.maxHealth;
                    gs.hunger = gs.maxHunger;
                    gs.dead = false;
                    gs.flying = false;
                }
                for (int cx = -1; cx <= 1; cx++) {
                    for (int cz = -1; cz <= 1; cz++) { world.loadChunkImmediate(cx, cz); }
                }
                for (int ii = 0; ii < world.count; ii++) world.buildMesh(ii);
                if (world.isPlayerStuck(gs.px, gs.py, gs.pz)) {
                    gs.py = world.getSpawnY(gs.px, gs.pz);
                    cam.x = gs.px; cam.y = gs.py + 1.62; cam.z = gs.pz;
                    gs.vx = 0.0; gs.vy = 0.0; gs.vz = 0.0;
                }
                gs.gameState = 1; gs.grabbed = true; win.setCursorGrabbed(true); gs.setTimer = 15;
            }

            // Create New World button
            if (btnCreateSelect.clicked && gs.setTimer <= 0) {
                inputWorldName.text = "New World";
                inputSeed.text = "";
                createGameMode = "Survival";
                gs.gameState = 6;
                gs.setTimer = 15;
            }

            // Delete World button
            if (btnDeleteWorld.clicked && gs.selectedWorldId.length() > 0 && gs.setTimer <= 0) {
                deleteWorld(gs.selectedWorldId);
                gs.selectedWorldId = "";
                cachedWorldList = loadWorldList();
                if (cachedWorldList.size() > 0) {
                    gs.selectedWorldId = cachedWorldList.get(0).id;
                }
                gs.setTimer = 15;
            }

            // Cancel button
            if (btnCancelSelect.clicked && gs.setTimer <= 0) {
                gs.gameState = 0;
                gs.setTimer = 15;
            }
        }

        // ── Create New World Screen ───────────────────────────────────────────
        if (gs.gameState == 6) {
            drawCreateWorldMenu(win, hudSh, quad, sw, sh,
                                inputWorldName, btnGameMode, inputSeed,
                                btnConfirmCreate, btnCancelCreate,
                                createGameMode, mx, my, mouseLeft);

            // Toggle game mode
            if (btnGameMode.clicked && gs.setTimer <= 0) {
                if (createGameMode == "Survival") {
                    createGameMode = "Creative";
                } else {
                    createGameMode = "Survival";
                }
                gs.setTimer = 15;
            }

            if (win.isKeyPressed(Key.Escape) && gs.setTimer <= 0) {
                gs.gameState = 5;
                gs.setTimer = 15;
            }

            if (btnCancelCreate.clicked && gs.setTimer <= 0) {
                gs.gameState = 5;
                gs.setTimer = 15;
            }

            if (btnConfirmCreate.clicked && gs.setTimer <= 0) {
                string wName = inputWorldName.text.trim();
                if (wName.length() == 0) wName = "New World";

                int genSeed = parseSeed(inputSeed.text);
                if (genSeed == 0) {
                    genSeed = (cast<int>(Time.seconds() * 1000.0) ^ cast<int>(System.nanoTime())) & 0x7FFFFFFF;
                    if (genSeed <= 0) genSeed = 1337;
                }

                WorldMeta createdMeta = createWorldEntry(wName, createGameMode, genSeed);
                gs.selectedWorldId = createdMeta.id;

                world.initWorld(genSeed, createdMeta.id);

                gs.px = 0.5;
                gs.pz = 0.5;
                gs.py = cast<double>(worldSurfaceAt(0, 0, world.worldNoise) + 1);
                cam.yaw = 0;
                cam.pitch = 0;
                gs.worldTime = 0.25;
                gs.health = gs.maxHealth;
                gs.hunger = gs.maxHunger;
                gs.dead = false;
                gs.flying = (createGameMode == "Creative");

                hotbar[0].set(BLOCK_GRASS, 64);
                hotbar[1].set(BLOCK_DIRT,   64);
                hotbar[2].set(BLOCK_STONE, 64);
                hotbar[3].set(BLOCK_COBBLE, 64);
                hotbar[4].set(BLOCK_PLANKS, 64);
                hotbar[5].set(BLOCK_LOG,    64);
                hotbar[6].set(BLOCK_SAND,  64);
                hotbar[7].set(BLOCK_GLASS,  32);
                hotbar[8].set(BLOCK_BRICK, 32);
                for (int ii = 0; ii < 27; ii++) inventory[ii].setEmpty();

                saveGameById(createdMeta.id, gs.px, gs.py, gs.pz, cam.yaw, cam.pitch,
                             gs.health, hotbar, inventory, gs.worldTime, world.seed);
                world.saveWorldChunksById(createdMeta.id);

                for (int cx = -1; cx <= 1; cx++) {
                    for (int cz = -1; cz <= 1; cz++) { world.loadChunkImmediate(cx, cz); }
                }
                for (int ii = 0; ii < world.count; ii++) world.buildMesh(ii);

                gs.py = world.getSpawnY(gs.px, gs.pz);
                cam.x = gs.px; cam.y = gs.py + 1.62; cam.z = gs.pz;
                gs.vx = 0.0; gs.vy = 0.0; gs.vz = 0.0;

                gs.gameState = 1;
                gs.grabbed = true;
                win.setCursorGrabbed(true);
                gs.setTimer = 15;
            }
        }

        // ── Settings menu ─────────────────────────────────────────────────────
        if (gs.gameState == 2) {
            sliderSens.value = gs.mouseSens * 1000.0;
            sliderRD.value   = cast<float>(gs.renderR);

            drawSettings(win, hudSh, quad, sw, sh,
                         btnResume, btnSaveQuit, sliderRD, sliderSens,
                         gs.health, gs.maxHealth, gs.hunger, gs.maxHunger, gs.worldTime,
                         mx, my, mouseLeft, gs.flying, gs.showDebug);

            gs.renderR   = cast<int>(Math.round(sliderRD.value));
            if (gs.renderR < 2)  gs.renderR = 2;
            if (gs.renderR > 32) gs.renderR = 32;
            gs.mouseSens = sliderSens.value * 0.001;

            if (btnResume.clicked && gs.setTimer <= 0) {
                gs.gameState = 1; gs.grabbed = true; win.setCursorGrabbed(true); gs.setTimer = 15;
            }
            if (btnSaveQuit.clicked && gs.setTimer <= 0) {
                if (world.currentWorldId.length() > 0) {
                    saveGameById(world.currentWorldId, gs.px, gs.py, gs.pz, cam.yaw, cam.pitch,
                                 gs.health, hotbar, inventory, gs.worldTime, world.seed);
                    world.saveWorldChunksById(world.currentWorldId);
                } else {
                    saveGame(gs.selectedSlot, gs.px, gs.py, gs.pz, cam.yaw, cam.pitch,
                             gs.health, hotbar, inventory, gs.worldTime, world.seed);
                    world.saveWorldChunks(gs.selectedSlot);
                }
                cachedWorldList = loadWorldList();
                gs.gameState = 0; gs.setTimer = 15;
            }
        }

        // ── Inventory screen ──────────────────────────────────────────────────
        if (gs.gameState == 3) {
            invScreen.draw(win, hudSh, quad, sw, sh, mx, my, mouseLeft, mouseRight);
            invScreen.syncTo(hotbar, inventory);
            if (win.isKeyPressed(Key.E) && gs.invTimer <= 0) {
                gs.gameState = 1; gs.grabbed = true; win.setCursorGrabbed(true); gs.invTimer = 15;
            }
        }

        // ── Death screen ──────────────────────────────────────────────────────
        if (gs.gameState == 4) {
            drawDeathScreen(win, hudSh, quad, sw, sh, btnRespawn);
            btnRespawn.update(mx, my, mouseLeft);
            btnRespawn.draw(win, hudSh, quad, sw, sh);
            if ((btnRespawn.clicked || win.isKeyPressed(Key.R)) && gs.respawnTimer <= 0) {
                gs.px = 0.5; gs.pz = 0.5;
                gs.py = world.getSpawnY(gs.px, gs.pz);
                cam.x = gs.px; cam.y = gs.py + 1.62; cam.z = gs.pz;
                gs.vx = 0.0; gs.vy = 0.0; gs.vz = 0.0;
                gs.health = gs.maxHealth; gs.hunger = gs.maxHunger;
                gs.dead = false; gs.gameState = 1;
                gs.grabbed = true; win.setCursorGrabbed(true);
                gs.respawnTimer = 30;
            }
        }

        win.enableDepthTest(true);
        win.swapBuffers();
        gs.frame++;
    }
}
