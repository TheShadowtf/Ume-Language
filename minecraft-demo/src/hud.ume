// ═══════════════════════════════════════════════════════════════════════════
// hud.ume — In-game HUD: 9-slot hotbar, classic hearts, hunger bar,
//           crosshair, day/night indicator, debug overlay, held-item name
// ═══════════════════════════════════════════════════════════════════════════

import std.math.*;

// ── Draw heart icon (MC 1.8 style) at (x, y), given state:
//   state = 0 (empty), 1 (half), 2 (full), 3 (full + vignette)
// ─────────────────────────────────────────────────────────────────────────────
public func void drawHeart(Window win, Shader hudSh, Mesh quad,
                           float x, float y, int state,
                           float sw, float sh) {
    float size = 16.0;
    // Outer dark border (always)
    drawRect2D(win, hudSh, quad, x, y, size, size, 0.0, 0.0, 0.0, 1.0, sw, sh);
    // Background (empty heart — darker red)
    drawRect2D(win, hudSh, quad, x + 1, y + 1, size - 2, size - 2, 0.30, 0.05, 0.05, 1.0, sw, sh);

    if (state == 2) {
        // Full red
        drawRect2D(win, hudSh, quad, x + 1, y + 1, size - 2, size - 2, 0.85, 0.15, 0.15, 1.0, sw, sh);
        // Highlight pixel (top-left)
        drawRect2D(win, hudSh, quad, x + 2, y + 2, 4, 3, 1.0, 0.55, 0.55, 1.0, sw, sh);
    } else if (state == 1) {
        // Half: left red, right dark
        drawRect2D(win, hudSh, quad, x + 1, y + 1, (size - 2) * 0.5, size - 2, 0.85, 0.15, 0.15, 1.0, sw, sh);
        drawRect2D(win, hudSh, quad, x + 2, y + 2, 4, 3, 1.0, 0.55, 0.55, 1.0, sw, sh);
    }
    // Inner top highlight (subtle)
    drawRect2D(win, hudSh, quad, x + 1, y + 1, size - 2, 1, 1.0, 0.40, 0.40, 0.30, sw, sh);
}

// ── Draw hunger icon (drumstick-like simplified to a square with shading) ───
public func void drawHunger(Window win, Shader hudSh, Mesh quad,
                            float x, float y, int state,
                            float sw, float sh) {
    float size = 16.0;
    drawRect2D(win, hudSh, quad, x, y, size, size, 0.0, 0.0, 0.0, 1.0, sw, sh);
    drawRect2D(win, hudSh, quad, x + 1, y + 1, size - 2, size - 2, 0.20, 0.18, 0.10, 1.0, sw, sh);
    if (state == 2) {
        drawRect2D(win, hudSh, quad, x + 1, y + 1, size - 2, size - 2, 0.75, 0.55, 0.15, 1.0, sw, sh);
        drawRect2D(win, hudSh, quad, x + 2, y + 2, 4, 3, 1.0, 0.85, 0.40, 1.0, sw, sh);
    } else if (state == 1) {
        drawRect2D(win, hudSh, quad, x + 1, y + 1, (size - 2) * 0.5, size - 2, 0.75, 0.55, 0.15, 1.0, sw, sh);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// drawHUD — main in-game HUD (hotbar, hearts, hunger, crosshair, debug)
// ═══════════════════════════════════════════════════════════════════════════
public func void drawHUD(
    Window win, Shader hudSh, Mesh quad, float sw, float sh,
    ItemStack[] hotbar, int hotbarSel,
    int health, int maxHealth, int hunger, int maxHunger,
    bool grabbed, bool flying, bool showDebug,
    int currentFPS, double px, double py, double pz,
    int chunkCount, int chunkCap, int mobCount, double worldTime,
    bool isNight, int selectedBlockId, double heldItemTimer
) {
    int hotbarSlots = 9;

    // ── Hotbar ────────────────────────────────────────────────────────────────
    float slotW = 50.0; float pad = 4.0;
    float totW = cast<float>(hotbarSlots) * (slotW + pad) - pad;
    float startX = (sw - totW) * 0.5;
    float baseY  = sh - slotW - 14.0;

    // Hotbar frame (dark slot strip with beveled border)
    drawRect2D(win, hudSh, quad, startX - 4, baseY - 4, totW + 8, slotW + 8, 0.10, 0.10, 0.12, 1.0, sw, sh);
    // Top-left highlight
    drawRect2D(win, hudSh, quad, startX - 4, baseY - 4, totW + 8, 2, 0.55, 0.55, 0.55, 1.0, sw, sh);
    drawRect2D(win, hudSh, quad, startX - 4, baseY - 4, 2, slotW + 8, 0.55, 0.55, 0.55, 1.0, sw, sh);
    // Bottom-right shadow
    drawRect2D(win, hudSh, quad, startX - 4, baseY + slotW + 2, totW + 8, 2, 0.0, 0.0, 0.0, 1.0, sw, sh);
    drawRect2D(win, hudSh, quad, startX + totW + 2, baseY - 4, 2, slotW + 8, 0.0, 0.0, 0.0, 1.0, sw, sh);

    // Slot separators (already drawn as bg color)
    for (int si = 0; si < hotbarSlots; si++) {
        float sx = startX + cast<float>(si) * (slotW + pad);
        bool sel = (si == hotbarSel);

        if (sel) {
            // Selection highlight (white border around slot)
            drawRect2D(win, hudSh, quad, sx - 2, baseY - 2, slotW + 4, slotW + 4, 1.0, 1.0, 1.0, 1.0, sw, sh);
            drawRect2D(win, hudSh, quad, sx - 1, baseY - 1, slotW + 2, slotW + 2, 0.0, 0.0, 0.0, 1.0, sw, sh);
        }
        // Slot interior (dark)
        drawRect2D(win, hudSh, quad, sx, baseY, slotW, slotW, 0.13, 0.13, 0.16, 1.0, sw, sh);
        // Slot bevel
        drawRect2D(win, hudSh, quad, sx, baseY, slotW, 1, 0.30, 0.30, 0.32, 1.0, sw, sh);
        drawRect2D(win, hudSh, quad, sx, baseY, 1, slotW, 0.30, 0.30, 0.32, 1.0, sw, sh);
        drawRect2D(win, hudSh, quad, sx, baseY + slotW - 1, slotW, 1, 0.04, 0.04, 0.05, 1.0, sw, sh);
        drawRect2D(win, hudSh, quad, sx + slotW - 1, baseY, 1, slotW, 0.04, 0.04, 0.05, 1.0, sw, sh);

        // Block icon
        if (si < hotbar.length()) {
            ItemStack st = hotbar[si];
            if (!st.isEmpty()) {
                drawItemIcon(win, hudSh, quad, st.blockId, sx, baseY, slotW, sw, sh);
                drawItemCount(win, st.count, sx, baseY, slotW);
            }
        }

        // Slot number (1..9)
        string num = "" + (si + 1);
        win.drawTextDefaultRGB(num, sx + 3 + 1, baseY + 3 + 1, 0.0, 0.0, 0.0, 11.0);
        win.drawTextDefaultRGB(num, sx + 3, baseY + 3, 0.65, 0.65, 0.65, 11.0);
    }

    // ── Hearts (left of hotbar) — 10 hearts, each = 2 HP ─────────────────────
    if (!flying) {
        float heartSize = 16.0; float heartPad = 2.0;
        float heartY = baseY - 24.0;
        float heartsW = 10.0 * (heartSize + heartPad) - heartPad;
        float heartStartX = startX;
        for (int h = 0; h < 10; h++) {
            float hx = heartStartX + cast<float>(h) * (heartSize + heartPad);
            int state = 0;
            int hpForThis = health - h * 2;
            if (hpForThis >= 2) state = 2;
            else if (hpForThis == 1) state = 1;
            drawHeart(win, hudSh, quad, hx, heartY, state, sw, sh);
        }
    } else {
        // Fly mode indicator
        float flyY = baseY - 22;
        drawRect2D(win, hudSh, quad, startX, flyY, 130, 18, 0.15, 0.35, 0.70, 0.85, sw, sh);
        win.drawTextDefaultRGB("FLY MODE", startX + 6, flyY + 3, 0.55, 0.85, 1.0, 13.0);
    }

    // ── Hunger bar (right of hotbar) — 10 icons, each = 2 hunger ────────────
    if (!flying) {
        float hSize = 16.0; float hPad = 2.0;
        float hY = baseY - 24.0;
        float hEnd = startX + totW;
        for (int hu = 0; hu < 10; hu++) {
            float hx = hEnd - cast<float>(hu + 1) * (hSize + hPad) + hPad;
            int state = 0;
            int hgForThis = hunger - hu * 2;
            if (hgForThis >= 2) state = 2;
            else if (hgForThis == 1) state = 1;
            drawHunger(win, hudSh, quad, hx, hY, state, sw, sh);
        }
    }

    // ── Day/Night indicator (top-right) ───────────────────────────────────────
    float dayW = 100.0; float dayH = 14.0;
    float dayX = sw - dayW - 10; float dayY = 10.0;
    drawRect2D(win, hudSh, quad, dayX - 3, dayY - 3, dayW + 6, dayH + 6, 0.0, 0.0, 0.0, 0.7, sw, sh);
    drawRect2D(win, hudSh, quad, dayX, dayY, dayW, dayH, 0.05, 0.05, 0.15, 1.0, sw, sh);
    // Sun/moon position
    float sunPct = cast<float>(worldTime);
    float sunR = isNight ? 0.70 : 0.95;
    float sunG = isNight ? 0.75 : 0.88;
    float sunB = isNight ? 0.95 : 0.30;
    drawRect2D(win, hudSh, quad, dayX, dayY, dayW, dayH, sunR, sunG, sunB, 0.35, sw, sh);
    drawRect2D(win, hudSh, quad, dayX + dayW * sunPct - 5, dayY - 2, 10, dayH + 4, sunR, sunG, sunB, 1.0, sw, sh);
    // Border
    drawRect2D(win, hudSh, quad, dayX, dayY, dayW, 1, 0.55, 0.55, 0.55, 1.0, sw, sh);
    drawRect2D(win, hudSh, quad, dayX, dayY + dayH - 1, dayW, 1, 0.0, 0.0, 0.0, 1.0, sw, sh);

    // Time label
    int hour = cast<int>(worldTime * 24.0 + 6) % 24;
    string ampm = hour >= 12 ? "PM" : "AM";
    int displayHour = hour % 12; if (displayHour == 0) displayHour = 12;
    string timeStr = "" + displayHour + ":00 " + ampm;
    drawTextShadow(win, timeStr, dayX - 60, dayY, 1.0, 1.0, 0.7, 13.0);

    // ── Crosshair ────────────────────────────────────────────────────────────
    if (grabbed) {
        float cx = sw * 0.5; float cy = sh * 0.5;
        // Shadow
        drawRect2D(win, hudSh, quad, cx - 11, cy - 1.5, 22, 3, 0.0, 0.0, 0.0, 0.8, sw, sh);
        drawRect2D(win, hudSh, quad, cx - 1.5, cy - 11, 3, 22, 0.0, 0.0, 0.0, 0.8, sw, sh);
        // White
        drawRect2D(win, hudSh, quad, cx - 10, cy - 1, 20, 2, 1.0, 1.0, 1.0, 0.9, sw, sh);
        drawRect2D(win, hudSh, quad, cx - 1, cy - 10, 2, 20, 1.0, 1.0, 1.0, 0.9, sw, sh);
    }

    // ── Held-item name popup (when hotbar selection changes) ─────────────────
    if (heldItemTimer > 0 && selectedBlockId != 0) {
        string nm = Blocks.name(selectedBlockId);
        float textW = cast<float>(nm.length()) * 9.0;
        float popY = baseY - 60;
        float popX = (sw - textW) * 0.5;
        drawRect2D(win, hudSh, quad, popX - 6, popY - 4, textW + 12, 24, 0.0, 0.0, 0.0, 0.55, sw, sh);
        drawTextShadow(win, nm, popX, popY, 1.0, 1.0, 1.0, 16.0);
    }

    // ── Debug overlay (F3) ───────────────────────────────────────────────────
    if (showDebug) {
        float dbgX = 6.0; float dbgY = 6.0;
        float dbgW = 280.0; float dbgH = 144.0;
        drawRect2D(win, hudSh, quad, dbgX - 3, dbgY - 3, dbgW + 6, dbgH + 6, 0.0, 0.0, 0.0, 0.70, sw, sh);
        drawRect2D(win, hudSh, quad, dbgX - 3, dbgY - 3, dbgW + 6, 2, 0.30, 0.30, 0.36, 1.0, sw, sh);

        float lineH = 18.0;
        drawTextShadow(win, "UmeCraft Debug (v6.0)", dbgX, dbgY, 1.0, 0.87, 0.10, 14.0);
        drawTextShadow(win, "FPS: " + currentFPS, dbgX, dbgY + lineH, 0.80, 1.0, 0.80, 14.0);
        drawTextShadow(win, "XYZ: " + cast<int>(px) + " / " + cast<int>(py) + " / " + cast<int>(pz),
                       dbgX, dbgY + lineH*2, 0.80, 1.0, 0.80, 14.0);
        drawTextShadow(win, "Chunks: " + chunkCount + "/" + chunkCap, dbgX, dbgY + lineH*3, 0.80, 1.0, 0.80, 14.0);
        drawTextShadow(win, "Mobs: " + mobCount, dbgX, dbgY + lineH*4, 0.80, 1.0, 0.80, 14.0);
        drawTextShadow(win, "HP: " + health + "/" + maxHealth, dbgX, dbgY + lineH*5, 0.80, 1.0, 0.80, 14.0);
        drawTextShadow(win, "Hunger: " + hunger + "/" + maxHunger, dbgX, dbgY + lineH*6, 0.80, 1.0, 0.80, 14.0);
        string modeStr = flying ? "Creative" : "Survival";
        drawTextShadow(win, "Mode: " + modeStr, dbgX, dbgY + lineH*7, 0.80, 1.0, 0.80, 14.0);
    }
}
