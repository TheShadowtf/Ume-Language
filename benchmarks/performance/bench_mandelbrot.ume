package Benchmarks;

import std.system.*;

public class Main {
    public static func int computeMandelbrot(int width, int height, int maxIter) {
        double xMin = -2.0;
        double xMax = 1.0;
        double yMin = -1.5;
        double yMax = 1.5;

        double dx = (xMax - xMin) / cast<double>(width);
        double dy = (yMax - yMin) / cast<double>(height);

        int checksum = 0;
        int py = 0;
        while (py < height) {
            double y0 = yMin + cast<double>(py) * dy;
            int px = 0;
            while (px < width) {
                double x0 = xMin + cast<double>(px) * dx;
                double x = 0.0;
                double y = 0.0;
                int iter = 0;

                while (x * x + y * y <= 4.0 && iter < maxIter) {
                    double xtemp = x * x - y * y + x0;
                    y = 2.0 * x * y + y0;
                    x = xtemp;
                    iter++;
                }

                checksum = (checksum + iter) % 1000000007;
                px++;
            }
            py++;
        }
        return checksum;
    }

    public static func void main() {
        // Warmup
        computeMandelbrot(20, 20, 10);

        long t0 = System.currentTimeMillis();
        int checksum = computeMandelbrot(150, 150, 100);
        long t1 = System.currentTimeMillis();
        double timeMs = cast<double>(t1 - t0);

        Console.println("[BENCHMARK_RESULT] {\"name\": \"mandelbrot_float_math\", \"time_ms\": " + timeMs + ", \"result\": \"" + checksum + "\"}");
    }
}
