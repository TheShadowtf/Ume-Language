package Benchmarks;

import std.collections.*;
import std.system.*;

public class Main {
    public static func int countPrimesTrial(int limit) {
        int count = 0;
        int num = 2;
        while (num <= limit) {
            bool isPrime = true;
            int i = 2;
            while (i * i <= num) {
                if (num % i == 0) {
                    isPrime = false;
                    break;
                }
                i++;
            }
            if (isPrime) {
                count++;
            }
            num++;
        }
        return count;
    }

    public static func int sieve(int limit) {
        List<bool> isPrime = new List<bool>();
        int i = 0;
        while (i <= limit) {
            isPrime.add(true);
            i++;
        }
        isPrime.set(0, false);
        isPrime.set(1, false);

        int p = 2;
        while (p * p <= limit) {
            if (isPrime.get(p)) {
                int multiple = p * p;
                while (multiple <= limit) {
                    isPrime.set(multiple, false);
                    multiple = multiple + p;
                }
            }
            p++;
        }

        int count = 0;
        int j = 2;
        while (j <= limit) {
            if (isPrime.get(j)) {
                count++;
            }
            j++;
        }
        return count;
    }

    public static func void main() {
        // Warmup
        countPrimesTrial(100);
        sieve(100);

        long t0 = System.currentTimeMillis();
        int resTrial = countPrimesTrial(20000);
        long t1 = System.currentTimeMillis();
        double timeTrial = cast<double>(t1 - t0);

        long t2 = System.currentTimeMillis();
        int resSieve = sieve(50000);
        long t3 = System.currentTimeMillis();
        double timeSieve = cast<double>(t3 - t2);

        Console.println("[BENCHMARK_RESULT] {\"name\": \"primes_trial_division\", \"time_ms\": " + timeTrial + ", \"result\": \"" + resTrial + "\"}");
        Console.println("[BENCHMARK_RESULT] {\"name\": \"primes_sieve_eratosthenes\", \"time_ms\": " + timeSieve + ", \"result\": \"" + resSieve + "\"}");
    }
}
